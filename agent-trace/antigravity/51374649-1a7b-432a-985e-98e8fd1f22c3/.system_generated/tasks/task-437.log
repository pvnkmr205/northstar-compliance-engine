1266:         verifications = [AuditStep(
1267:             "VERIFICATION", "account_service", account_id,
1268:             "VERIFY_RECORD_ABSENT", "ABSENT", account_evidence,
1269:         )] if account_evidence else []
1270: 
1271:         account_file = account_evidence
1272:         trace_scoped = False
1273:         if account_file:
1274:             metadata = conn.execute(
1275:                 "SELECT file_path,origin FROM evidence_files WHERE file_id=?",
1276:                 (account_file,),
1277:             ).fetchone()
1278:             trace_scoped = bool(metadata and "log" in
1279:                                 f"{metadata[0] or ''} {metadata[1] or ''}".casefold())
1280:         for (system, resource), record in sorted(
1281:             eligible.items(),
1282:             key=lambda item: (SYSTEM_ORDER.get(item[0][0], 99), item[0][1]),
1283:         ):
1284:             if system == "account_service" or resource == account_id:
1285:                 continue
1286:             if trace_scoped and record["file_id"] != account_file:
1287:                 continue
1288:             operation, state = state_map[record["state"]]
1289:             verifications.append(AuditStep(
1290:                 "VERIFICATION", system, resource, operation, state,
1291:                 record["file_id"],
1292:             ))
1293:         return "COMPLETE", verifications
1294: 
1295:     return status, steps
1296: 
