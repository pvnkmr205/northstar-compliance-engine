             if rec_file.suffix == \".json\":\n                    try:\n                        data = json.loads(rec_file.read_text(encoding=\"utf-8\", errors=\"ignore\"))\n                        items = []\n                        if isinstance(data, list):\n                            items = data\n                        elif isinstance(data, dict):\n                            for key in (\"records\", \"snapshots\", \"service_exports\"):\n                                if key in data and isinstance(data[key], list):\n                                    items = data[key]\n                                    break\n\n                        for item in items:\n                            if not isinstance(item, dict):\n                                continue\n                            res_id = _clean_str(item.get(\"resource_id\"))\n                            if not res_id:\n                                continue\n\n                            sys_id = item.get(\"system\") or item.get(\"service\") or item.get(\"system_id\")\n                            if not sys_id:\n                                if res_id.startswith(\"analytics_\"):\n                                    sys_id = \"analytics_platform\"\n                                elif res_id.startswith(\"account_\"):\n                                    sys_id = \"account_service\"\n                                elif res_id.startswith(\"audit_record_\"):\n                                    sys_id = \"security_service\"\n                                elif res_id.startswith(\"search_\"):\n                                    sys_id = \"search_service\"\n                                elif res_id.startswith(\"support_\"):\n                                    sys_id = \"support_platform\"\n                                elif res_id.startswith(\"export_\"):\n                                    sys_id = \"export_service\"\n                                elif res_id.startswith(\"backup_\"):\n                                    sys_id = \"backup_service\"\n                                elif res_id.startswith(\"data_flow_\"):\n                                    sys_id = \"integration_service\"\n\n                            uid = item.get(\"user_id\") or item.get(\"customer_reference\") or item.get(\"subject_reference\")\n                            eml = (\n                                item.get(\"email\")\n                                or item.get(\"owner_email\")\n                                or item.get(\"subject_reference\")\n                                or item.get(\"lookup_key\")\n                            )\n\n                            res_val = str(item.get(\"result\") or item.get(\"status\") or \"\").upper()\n                            if res_val in (\"NOT_FOUND\", \"ABSENT\", \"MISS\"):\n                                state = \"ABSENT\"\n                            elif (\n                                not _clean_str(uid)\n                                and not _clean_str(eml)\n                                and not _clean_str(item.get(\"phone\"))\n                                and not _clean_str(item.get(\"email_hash\"))\n                            ):\n                                state = \"ANONYMIZED\"\n                            else:\n                                state = \"PRESENT\"\n\n                            record_finding(fid, cap, sys_id, res_id, state, uid, eml)\n                    except Exception:\n                        pass\n                elif rec_file.suffix == \".txt\":\n                    try:\n                        for line in rec_file.read_text(encoding=\"utf-8\", errors=\"ignore\").splitlines():\n                            if \"|\" in line:\n                                parts = [x.strip() for x in line.split(\"|\")]\n                                if len(parts) >= 5:\n                                    line_sys = parts[1]\n                                    line_res = parts[2]\n                                    line_result = parts[4].upper()\n                                    line_subj = parts[5] if len(parts) > 5 else None\n                                    state = \"ABSENT\" if line_result == \"NOT_FOUND\" else \"PRESENT\"\n                                    uid = line_subj if line_subj and line_subj.startswith(\"user_\") else None\n                                    eml = line_subj if line_subj and \"@\" in line_subj else None\n                                    record_finding(fid, cap, line_sys, line_res, state, uid, eml)\n                    except Exception:\n                        pass\n\n        # 4. Batch Inserts\n        if merged_records:\n            conn.executemany(\n                \"\"\"\n                INSERT OR REPLACE INTO evidence_records (\n                    file_id, captured_at, system_id, resource_id, verified_state, user_id, email\n                ) VALUES (?, ?, ?, ?, ?, ?, ?)\n                \"\"\",\n                list(merged_records.values()),\n            )\n            conn.commit()\n\n        # 5. CORRELATE ANONYMIZED ANALYTICS FROM system_activity\n        # Load deletion requests with reported_at\n        deletion_requests_list: List[Tuple[str, datetime]] = []\n\n        try:\n            for r in conn.execute(\n                \"SELECT email, reported_at FROM deletion_requests WHERE email IS NOT NULL AND reported_at IS NOT NULL\"\n            ).fetchall():\n                t_dt = _parse_iso_ts(r[1])\n                if r[0] and t_dt:\n                    deletion_requests_list.append((r[0].strip(), t_dt))\n        except Exception:\n            pass\n\n        for csv_name in (\"sample_deletion_requests.csv\", \"deletion_requests.csv\"):\n            for candidate in [evidence_path.parent / csv_name, Path(\"dataset\") / csv_name]:\n                if candidate.is_file():\n                    try:\n                        with candidate.open(\"r\", encoding=\"utf-8-sig\", newline=\"\") as f:\n                            for row in csv.DictReader(f):\n                                eml = row.get(\"email\")\n                                rep = row.get(\"reported_at\")\n                                if eml and rep:\n                                    t_dt = _parse_iso_ts(rep)\n                                    if t_dt:\n                                        deletion_requests_list.append((eml.strip(), t_dt))\n                        break\n                    except Exception:\n                        pass\n\n        # Candidate rows: analytics_platform, ANONYMIZED, NULL or empty user_id/email\n        candidates = conn.execute(\n            \"\"\"\n            SELECT resource_id FROM evidence_records\n            WHERE system_id = 'analytics_platform'\n              AND verified_state = 'ANONYMIZED'\n              AND (user_id IS NULL OR user_id = '' OR email IS NULL OR email = '')\n            \"\"\"\n        ).fetchall()\n\n        updates: List[Tuple[str, Optional[str], str]] = []\n\n        for (res_id,) in candidates:\n            event_time_str = None\n            try:\n                row = conn.execute(\n                    \"SELECT event_time FROM system_activity WHERE resource_id = ? AND event_type = 'ANONYMIZE_RECORD' LIMIT 1\",\n                    (res_id,),\n                ).fetchone()\n                if row and row[0]:\n                    event_time_str = row[0]\n            except Exception:\n                pass\n\n            if not event_time_str:\n                for candidate in [\n                    evidence_path.parent / \"system_activity.csv\",\n                    Path(\"dataset/system_activity.csv\"),\n                ]:\n                    if candidate.is_file():\n                        try:\n                            with candidate.open(\"r\", encoding=\"utf-8-sig\", newline=\"\") as f:\n                                for row in csv.DictReader(f):\n                                    if (\n                                        row.get(\"resource_id\") == res_id\n                                        and row.get(\"event_type\") == \"ANONYMIZE_RECORD\"\n                                    ):\n                                        event_time_str = row.get(\"event_time\")\n                                        break\n                            if event_time_str:\n                                break\n                        except Exception:\n                            pass\n\n            if not event_time_str:\n                continue\n\n            ev_dt = _parse_iso_ts(event_time_str)\n            if not ev_dt:\n                continue\n\n            matched_email = None\n            closest_diff = None\n            for req_email, req_dt in deletion_requests_list:\n                diff = abs((req_dt - ev_dt).total_seconds())\n                if diff <= 900:  # within +/- 15 minutes\n                    if closest_diff is None or diff < closest_diff:\n                        closest_diff = diff\n                        matched_email = req_email\n\n            if matched_email:\n                matched_user_id = email_to_user.get(matched_email.lower())\n                updates.append((matched_email, matched_user_id, res_id))\n\n        if updates:\n            conn.executemany(\n                \"\"\"\n                UPDATE evidence_records\n                SET email = ?,\n                    user_id = COALESCE(?, user_id)\n                WHERE resource_id = ?\n                \"\"\",\n                updates,\n            )\n            conn.commit()\n\n    finally:\n        if close_conn and conn:\n            conn.close()\n\n\nif __name__ == \"__main__\":\n    index_unstructured_evidence()\n","Overwrite":true,"Path":"C:\\Users\\Pavan\\hackerrank-orchestrate-october26\\src\\evidence_indexer.py"}}]}
