{"step_index":407,"source":"MODEL","type":"PLANNER_RESPONSE","status":"DONE","created_at":"2026-10-24T19:02:23Z","input_tokens":6123,"cache_read_tokens":175662,"output_tokens":5466,"tool_calls":[{"name":"write_file","args":{"Content":"#!/usr/bin/env python3\n\"\"\"\nZero-token local evidence indexer for Northstar Shop Deletion Audit dataset.\nCorrelates trace events across logs and records into SQLite cache/northstar.db.\n\"\"\"\n\nfrom __future__ import annotations\n\nimport csv\nimport json\nimport re\nimport sqlite3\nfrom datetime import datetime\nfrom pathlib import Path\nfrom typing import Any, Dict, List, Optional, Tuple\n\nKV_REGEX = re.compile(r'(\\w+)=(?:\"([^\"]*)\"|(\\S+))')\n\n\ndef _clean_str(val: Any) -> Optional[str]:\n    if val is None:\n        return None\n    s = str(val).strip()\n    if not s or s.lower() in (\"null\", \"none\"):\n        return None\n    return s\n\n\ndef _parse_iso_ts(ts_str: Any) -> Optional[datetime]:\n    if not ts_str:\n        return None\n    s = str(ts_str).strip()\n    if not s or s.lower() in (\"null\", \"none\"):\n        return None\n    try:\n        return datetime.fromisoformat(s.replace(\"Z\", \"+00:00\"))\n    except Exception:\n        return None\n\n\ndef index_unstructured_evidence(\n    evidence_dir: Path = Path(\"dataset/evidence\"),\n    conn: Optional[sqlite3.Connection] = None,\n) -> None:\n    \"\"\"\n    Parse files in logs/ and records/, perform two-pass trace correlation,\n    correlate anonymized analytics from system_activity, and populate evidence_records.\n    \"\"\"\n    evidence_path = Path(evidence_dir)\n    close_conn = False\n\n    if conn is None:\n        db_path = Path(\"cache/northstar.db\")\n        db_path.parent.mkdir(parents=True, exist_ok=True)\n        conn = sqlite3.connect(db_path)\n        close_conn = True\n\n    try:\n        # 1. Table Schema\n        conn.execute(\n            \"\"\"\n            CREATE TABLE IF NOT EXISTS evidence_records (\n                file_id TEXT,\n                captured_at TEXT,\n                system_id TEXT,\n                resource_id TEXT PRIMARY KEY,\n                verified_state TEXT,       -- 'ABSENT', 'PRESENT', 'ANONYMIZED', 'REDACTED'\n                user_id TEXT,\n                email TEXT\n            );\n            \"\"\"\n        )\n        conn.execute(\"CREATE INDEX IF NOT EXISTS idx_ev_res ON evidence_records(resource_id);\")\n        conn.execute(\"CREATE INDEX IF NOT EXISTS idx_ev_user ON evidence_records(user_id);\")\n        conn.execute(\"CREATE INDEX IF NOT EXISTS idx_ev_email ON evidence_records(email);\")\n\n        # Load file metadata: filename -> (file_id, captured_at)\n        file_meta: Dict[str, Tuple[str, str]] = {}\n        try:\n            cur = conn.execute(\"SELECT file_id, file_path, captured_at FROM evidence_files\")\n            for row in cur.fetchall():\n                if row[1]:\n                    file_meta[Path(row[1]).name] = (row[0] or \"\", row[2] or \"\")\n        except Exception:\n            pass\n\n        ef_csv_candidates = [\n            evidence_path.parent / \"evidence_files.csv\",\n            Path(\"dataset/evidence_files.csv\"),\n        ]\n        for ef_csv in ef_csv_candidates:\n            if ef_csv.is_file():\n                try:\n                    with ef_csv.open(\"r\", encoding=\"utf-8-sig\", newline=\"\") as f:\n                        for row in csv.DictReader(f):\n                            fp = row.get(\"file_path\")\n                            if fp:\n                                file_meta[Path(fp).name] = (\n                                    row.get(\"file_id\", \"\"),\n                                    row.get(\"captured_at\", \"\"),\n                                )\n                    break\n                except Exception:\n                    pass\n\n        # Load identity resolution mappings\n        email_to_user: Dict[str, str] = {}\n        user_to_email: Dict[str, str] = {}\n        try:\n            for r in conn.execute(\n                \"SELECT user_id, email FROM user_identities WHERE user_id IS NOT NULL AND email IS NOT NULL\"\n            ).fetchall():\n                if r[0] and r[1]:\n                    email_to_user[r[1].lower().strip()] = r[0].strip()\n                    user_to_email[r[0].strip()] = r[1].strip()\n        except Exception:\n            pass\n\n        for candidate in [\n            evidence_path.parent / \"user_identities.csv\",\n            Path(\"dataset/user_identities.csv\"),\n        ]:\n            if candidate.is_file():\n                try:\n                    with candidate.open(\"r\", encoding=\"utf-8-sig\", newline=\"\") as f:\n                        for row in csv.DictReader(f):\n                            uid = row.get(\"user_id\")\n                            eml = row.get(\"email\")\n                            if uid and eml:\n                                email_to_user[eml.lower().strip()] = uid.strip()\n                                user_to_email[uid.strip()] = eml.strip()\n                    break\n                except Exception:\n                    pass\n\n        merged_records: Dict[str, Tuple[str, str, str, str, str, Optional[str], Optional[str]]] = {}\n\n        def record_finding(\n            fid: str,\n            cap: str,\n            sys_id: Optional[str],\n            res_id: str,\n            state: Optional[str],\n            uid: Optional[str],\n            eml: Optional[str],\n        ) -> None:\n            if not res_id:\n                return\n            sys_id = _clean_str(sys_id) or \"\"\n            uid = _clean_str(uid)\n            eml = _clean_str(eml)\n\n            if eml and \"@\" not in eml:\n                if not uid and eml.startswith(\"user_\"):\n                    uid = eml\n                    eml = None\n\n            if eml and not uid:\n                uid = email_to_user.get(eml.lower())\n            if uid and not eml:\n                eml = user_to_email.get(uid)\n\n            if res_id in merged_records:\n                old_fid, old_cap, old_sys, _, old_state, old_uid, old_eml = merged_records[res_id]\n                fid = fid or old_fid\n                cap = cap or old_cap\n                sys_id = sys_id or old_sys\n                uid = uid or old_uid\n                eml = eml or old_eml\n                state = state or old_state\n\n            merged_records[res_id] = (\n                fid or \"\",\n                cap or \"\",\n                sys_id,\n                res_id,\n                state or \"PRESENT\",\n                uid,\n                eml,\n            )\n\n        # 2. TWO-PASS TRACE CORRELATION FOR LOGS\n        logs_dir = evidence_path / \"logs\"\n        if logs_dir.is_dir():\n            for log_file in sorted(logs_dir.glob(\"*.log\")):\n                fid, cap = file_meta.get(log_file.name, (\"\", \"\"))\n                trace_groups: Dict[str, List[Dict[str, Any]]] = {}\n\n                try:\n                    with log_file.open(\"r\", encoding=\"utf-8\", errors=\"ignore\") as f:\n                        for line_idx, line in enumerate(f):\n                            line = line.strip()\n                            if not line:\n                                continue\n\n                            entry: Dict[str, Any] = {}\n                            j_start = line.find(\"{\")\n                            if j_start != -1 and line.endswith(\"}\"):\n                                try:\n                                    entry = json.loads(line[j_start:])\n                                except Exception:\n                                    pass\n                            elif \"=\" in line:\n                                for m in KV_REGEX.findall(line):\n                                    k = m[0]\n                                    v = m[1] if m[1] != \"\" else m[2]\n                                    entry[k] = v\n\n                            trace_id = entry.get(\"trace_id\") or entry.get(\"requestId\")\n                            if not trace_id:\n                                trace_id = f\"__no_trace__{log_file.stem}_{line_idx}\"\n\n                            trace_groups.setdefault(str(trace_id), []).append(entry)\n                except Exception:\n                    continue\n\n                for trace_id, entries in trace_groups.items():\n                    # Pass 1: Extract Identifiers per trace\n                    trace_email: Optional[str] = None\n                    trace_user_id: Optional[str] = None\n\n                    for entry in entries:\n                        for k in (\n                            \"lookup_key\",\n                            \"subject_ref\",\n                            \"subject_reference\",\n                            \"email\",\n                            \"customer_email\",\n                            \"requester_email\",\n                            \"match_key\",\n                            \"correlation_key\",\n                        ):\n                            val = entry.get(k)\n                            if val is not None:\n                                val_str = str(val).strip()\n                                if not val_str or val_str.lower() in (\"null\", \"none\"):\n                                    continue\n                                if \"@\" in val_str and not trace_email:\n                                    trace_email = val_str\n                                if val_str.startswith(\"user_\") and not trace_user_id:\n                                    trace_user_id = val_str\n\n                    if trace_email and not trace_user_id:\n                        trace_user_id = email_to_user.get(trace_email.lower())\n                    if trace_user_id and not trace_email:\n                        trace_email = user_to_email.get(trace_user_id)\n\n                    # Pass 2: Extract Resources and assign identifiers\n                    for entry in entries:\n                        res_id = _clean_str(entry.get(\"resource_id\"))\n                        if not res_id:\n                            continue\n\n                        sys_id = (\n                            entry.get(\"service\")\n                            or entry.get(\"system\")\n                            or entry.get(\"system_id\")\n                            or entry.get(\"logger\")\n                        )\n                        if sys_id:\n                            sys_id = str(sys_id).strip()\n                        else:\n                            if res_id.startswith(\"analytics_\"):\n                                sys_id = \"analytics_platform\"\n                            elif res_id.startswith(\"account_\"):\n                                sys_id = \"account_service\"\n                            elif res_id.startswith(\"audit_record_\"):\n                                sys_id = \"security_service\"\n                            elif res_id.startswith(\"search_\"):\n                                sys_id = \"search_service\"\n                            elif res_id.startswith(\"support_\"):\n                                sys_id = \"support_platform\"\n                            elif res_id.startswith(\"export_\"):\n                                sys_id = \"export_service\"\n                            elif res_id.startswith(\"backup_\"):\n                                sys_id = \"backup_service\"\n                            elif res_id.startswith(\"data_flow_\"):\n                                sys_id = \"integration_service\"\n\n                        rows_val = str(entry.get(\"rows\") if entry.get(\"rows\") is not None else \"\").strip()\n                        status_val = str(\n                            entry.get(\"http_status\") if entry.get(\"http_status\") is not None else \"\"\n                        ).strip()\n                        event_val = str(entry.get(\"event\") or \"\")\n                        integrity_val = str(entry.get(\"integrity_check\") or \"\").lower()\n                        has_retention = (\n                            entry.get(\"retention_until\") is not None\n                            and str(entry.get(\"retention_until\")).lower() not in (\"null\", \"none\", \"\")\n                        )\n\n                        cust_ref = entry.get(\"customer_reference\")\n                        eml_val = entry.get(\"email\")\n                        cust_null = cust_ref is None or str(cust_ref).lower() in (\"null\", \"none\", \"\")\n                        eml_null = eml_val is None or str(eml_val).lower() in (\"null\", \"none\", \"\")\n\n                        # State mapping\n                        if (\n                            rows_val in (\"0\", \"404\")\n                            or status_val == \"404\"\n                            or (\"profile_lookup_completed\" in event_val and rows_val == \"0\")\n                            or str(entry.get(\"result\") or \"\").lower() in (\"miss\", \"not_found\")\n                        ):\n                            state = \"ABSENT\"\n                        elif (\n                            rows_val in (\"1\", \"200\")\n                            or status_val == \"200\"\n                            or integrity_val == \"passed\"\n                            or has_retention\n                            or str(entry.get(\"result\") or \"\").lower() in (\"hit\", \"found\")\n                            or event_val == \"audit_record_read_completed\"\n                        ):\n                            state = \"PRESENT\"\n                        elif cust_null and eml_null:\n                            state = \"ANONYMIZED\"\n                        else:\n                            state = \"PRESENT\"\n\n                        # Assign identifiers\n                        row_user = trace_user_id\n                        row_email = trace_email\n\n                        entry_user = (\n                            entry.get(\"user_id\")\n                            or entry.get(\"subject_ref\")\n                            or entry.get(\"customer_reference\")\n                        )\n                        if entry_user and str(entry_user).strip().startswith(\"user_\"):\n                            row_user = str(entry_user).strip()\n\n                        entry_email = entry.get(\"email\") or entry.get(\"lookup_key\")\n                        if entry_email and \"@\" in str(entry_email):\n                            row_email = str(entry_email).strip()\n\n                        if row_email and not row_user:\n                            row_user = email_to_user.get(row_email.lower())\n                        if row_user and not row_email:\n                            row_email = user_to_email.get(row_user)\n\n                        record_finding(fid, cap, sys_id, res_id, state, row_user, row_email)\n\n        # 3. Process records directory (JSON and TXT)\n        records_dir = evidence_path / \"records\"\n        if records_dir.is_dir():\n            for rec_file in sorted(records_dir.iterdir()):\n                fid, cap = file_meta.get(rec_file.name, (\"\", \"\"))\n                if rec_file.suffix == \".json\":\n                    try:\n                        data = json.loads(rec_file.read_text(encoding=\"utf-8\", errors=\"ignore\"))\n                        items = []\n                        if isinstance(data, list):\n                            items = data\n                        elif isinstance(data, dict):\n                            for key in (\"records\", \"snapshots\", \"service_exports\"):\n                                if key in data and isinstance(data[key], list):\n                                    items = data[key]\n                                    break\n\n                        for item in items:\n                            if not isinstance(item, dict):\n                                continue\n                            res_id = _clean_str(item.get(\"resource_id\"))\n                            if not res_id:\n                                continue\n\n                            sys_id = item.get(\"system\") or item.get(\"service\") or item.get(\"system_id\")\n                            if not sys_id:\n                                if res_id.startswith(\"analytics_\"):\n                                    sys_id = \"analytics_platform\"\n                                elif res_id.startswith(\"account_\"):\n                                    sys_id = \"account_service\"\n                                elif res_id.startswith(\"audit_record_\"):\n                                    sys_id = \"security_service\"\n                                elif res_id.startswith(\"search_\"):\n                                    sys_id = \"search_service\"\n                                elif res_id.startswith(\"support_\"):\n                                    sys_id = \"support_platform\"\n                                elif res_id.startswith(\"export_\"):\n                                    sys_id = \"export_service\"\n                                elif res_id.startswith(\"backup_\"):\n                                    sys_id = \"backup_service\"\n                                elif res_id.startswith(\"data_flow_\"):\n                                    sys_id = \"integration_service\"\n\n                            uid = item.get(\"user_id\") or item.get(\"customer_reference\") or item.get(\"subject_reference\")\n                            eml = (\n                                item.get(\"email\")\n                                or item.get(\"owner_email\")\n                                or item.get(\"subject_reference\")\n                                or item.get(\"lookup_key\")\n                            )\n\n                            res_val = str(item.get(\"result\") or item.get(\"status\") or \"\").upper()\n                            if res_val in (\"NOT_FOUND\", \"ABSENT\", \"MISS\"):\n                                state = \"ABSENT\"\n                            elif (\n                                not _clean_str(uid)\n                                and not _clean_str(eml)\n                                and not _clean_str(item.get(\"phone\"))\n                                and not _clean_str(item.get(\"email_hash\"))\n                            ):\n                                state = \"ANONYMIZED\"\n                            else:\n                                state = \"PRESENT\"\n\n                            record_finding(fid, cap, sys_id, res_id, state, uid, eml)\n                    except Exception:\n                        pass\n                elif rec_file.suffix == \".txt\":\n                    try:\n                        for line in rec_file.read_text(encoding=\"utf-8\", errors=\"ignore\").splitlines():\n                            if \"|\" in line:\n                                parts = [x.strip() for x in line.split(\"|\")]\n                                if len(parts) >= 5:\n                                    line_sys = parts[1]\n                                    line_res = parts[2]\n                                    line_result = parts[4].upper()\n                                    line_subj = parts[5] if len(parts) > 5 else None\n                                    state = \"ABSENT\" if line_result == \"NOT_FOUND\" else \"PRESENT\"\n                                    uid = line_subj if line_subj and line_subj.startswith(\"user_\") else None\n                                    eml = line_subj if line_subj and \"@\" in line_subj else None\n                                    record_finding(fid, cap, line_sys, line_res, state, uid, eml)\n                    except Exception:\n                        pass\n\n        # 4. Batch Inserts\n        if merged_records:\n            conn.executemany(\n                \"\"\"\n                INSERT OR REPLACE INTO evidence_records (\n                    file_id, captured_at, system_id, resource_id, verified_state, user_id, email\n                ) VALUES (?, ?, ?, ?, ?, ?, ?)\n                \"\"\",\n                list(merged_records.values()),\n            )\n            conn.commit()\n\n        # 5. CORRELATE ANONYMIZED ANALYTICS FROM system_activity\n        # Load deletion requests with reported_at\n        deletion_requests_list: List[Tuple[str, datetime]] = []\n\n        try:\n            for r in conn.execute(\n                \"SELECT email, reported_at FROM deletion_requests WHERE email IS NOT NULL AND reported_at IS NOT NULL\"\n            ).fetchall():\n                t_dt = _parse_iso_ts(r[1])\n                if r[0] and t_dt:\n                    deletion_requests_list.append((r[0].strip(), t_dt))\n        except Exception:\n            pass\n\n        for csv_name in (\"sample_deletion_requests.csv\", \"deletion_requests.csv\"):\n            for candidate in [evidence_path.parent / csv_name, Path(\"dataset\") / csv_name]:\n                if candidate.is_file():\n                    try:\n                        with candidate.open(\"r\", encoding=\"utf-8-sig\", newline=\"\") as f:\n                            for row in csv.DictReader(f):\n                                eml = row.get(\"email\")\n                                rep = row.get(\"reported_at\")\n                                if eml and rep:\n                                    t_dt = _parse_iso_ts(rep)\n                                    if t_dt:\n                                        deletion_requests_list.append((eml.strip(), t_dt))\n                        break\n                    except Exception:\n                        pass\n\n        # Candidate rows: analytics_platform, ANONYMIZED, NULL or empty user_id/email\n        candidates = conn.execute(\n            \"\"\"\n            SELECT resource_id FROM evidence_records\n            WHERE system_id = 'analytics_platform'\n              AND verified_state = 'ANONYMIZED'\n              AND (user_id IS NULL OR user_id = '' OR email IS NULL OR email = '')\n            \"\"\"\n        ).fetchall()\n\n        updates: List[Tuple[str, Optional[str], str]] = []\n\n        for (res_id,) in candidates:\n            event_time_str = None\n            try:\n                row = conn.execute(\n                    \"SELECT event_time FROM system_activity WHERE resource_id = ? AND event_type = 'ANONYMIZE_RECORD' LIMIT 1\",\n                    (res_id,),\n                ).fetchone()\n                if row and row[0]:\n                    event_time_str = row[0]\n            except Exception:\n                pass\n\n            if not event_time_str:\n                for candidate in [\n                    evidence_path.parent / \"system_activity.csv\",\n                    Path(\"dataset/system_activity.csv\"),\n                ]:\n                    if candidate.is_file():\n                        try:\n                            with candidate.open(\"r\", encoding=\"utf-8-sig\", newline=\"\") as f:\n                                for row in csv.DictReader(f):\n                                    if (\n                                        row.get(\"resource_id\") == res_id\n                                        and row.get(\"event_type\") == \"ANONYMIZE_RECORD\"\n                                    ):\n                                        event_time_str = row.get(\"event_time\")\n                                        break\n                            if event_time_str:\n                                break\n                        except Exception:\n                            pass\n\n            if not event_time_str:\n                continue\n\n            ev_dt = _parse_iso_ts(event_time_str)\n            if not ev_dt:\n                continue\n\n            matched_email = None\n            closest_diff = None\n            for req_email, req_dt in deletion_requests_list:\n                diff = abs((req_dt - ev_dt).total_seconds())\n                if diff <= 900:  # within +/- 15 minutes\n                    if closest_diff is None or diff < closest_diff:\n                        closest_diff = diff\n                        matched_email = req_email\n\n            if matched_email:\n                matched_user_id = email_to_user.get(matched_email.lower())\n                updates.append((matched_email, matched_user_id, res_id))\n\n        if updates:\n            conn.executemany(\n                \"\"\"\n                UPDATE evidence_records\n                SET email = ?,\n                    user_id = COALESCE(?, user_id)\n                WHERE resource_id = ?\n                \"\"\",\n                updates,\n            )\n            conn.commit()\n\n    finally:\n        if close_conn and conn:\n            conn.close()\n\n\nif __name__ == \"__main__\":\n    index_unstructured_evidence()\n","Overwrite":true,"Path":"C:\\Users\\Pavan\\AppData\\Local\\Programs\\antigravity\\src\\evidence_indexer.py"}}]}
