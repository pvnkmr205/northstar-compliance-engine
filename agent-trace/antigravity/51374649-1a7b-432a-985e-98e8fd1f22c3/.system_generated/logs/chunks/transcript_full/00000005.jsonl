{"step_index":414,"source":"MODEL","type":"PLANNER_RESPONSE","status":"DONE","created_at":"2026-10-24T19:03:12Z","input_tokens":3305,"cache_read_tokens":185908,"output_tokens":5725,"content":"#!/usr/bin/env python3\n\"\"\"\nZero-token local evidence indexer for Northstar Shop Deletion Audit dataset.\nCorrelates trace events across logs and records into SQLite cache/northstar.db.\n\"\"\"\n\nfrom __future__ import annotations\n\nimport csv\nimport json\nimport re\nimport sqlite3\nfrom datetime import datetime\nfrom pathlib import Path\nfrom typing import Any, Dict, List, Optional, Tuple\n\nKV_REGEX = re.compile(r'(\\w+)=(?:\"([^\"]*)\"|(\\S+))')\n\n\ndef _clean_str(val: Any) -> Optional[str]:\n    if val is None:\n        return None\n    s = str(val).strip()\n    if not s or s.lower() in (\"null\", \"none\"):\n        return None\n    return s\n\n\ndef _parse_iso_ts(ts_str: Any) -> Optional[datetime]:\n    if not ts_str:\n        return None\n    s = str(ts_str).strip()\n    if not s or s.lower() in (\"null\", \"none\"):\n        return None\n    try:\n        return datetime.fromisoformat(s.replace(\"Z\", \"+00:00\"))\n    except Exception:\n        return None\n\n\ndef index_unstructured_evidence(\n    evidence_dir: Path = Path(\"dataset/evidence\"),\n    conn: Optional[sqlite3.Connection] = None,\n) -> None:\n    \"\"\"\n    Parse files in logs/ and records/, perform two-pass trace correlation,\n    correlate anonymized analytics from system_activity, and populate evidence_records.\n    \"\"\"\n    evidence_path = Path(evidence_dir)\n    close_conn = False\n\n    if conn is None:\n        db_path = Path(\"cache/northstar.db\")\n        db_path.parent.mkdir(parents=True, exist_ok=True)\n        conn = sqlite3.connect(db_path)\n        close_conn = True\n\n    try:\n        # 1. Table Schema\n        conn.execute(\n            \"\"\"\n            CREATE TABLE IF NOT EXISTS evidence_records (\n                file_id TEXT,\n                captured_at TEXT,\n                system_id TEXT,\n                resource_id TEXT PRIMARY KEY,\n                verified_state TEXT,       -- 'ABSENT', 'PRESENT', 'ANONYMIZED', 'REDACTED'\n                user_id TEXT,\n                email TEXT\n            );\n            \"\"\"\n        )\n        conn.execute(\"CREATE INDEX IF NOT EXISTS idx_ev_res ON evidence_records(resource_id);\")\n        conn.execute(\"CREATE INDEX IF NOT EXISTS idx_ev_user ON evidence_records(user_id);\")\n        conn.execute(\"CREATE INDEX IF NOT EXISTS idx_ev_email ON evidence_records(email);\")\n\n        # Load file metadata: filename -> (file_id, captured_at)\n        file_meta: Dict[str, Tuple[str, str]] = {}\n        try:\n            cur = conn.execute(\"SELECT file_id, file_path, captured_at FROM evidence_files\")\n            for row in cur.fetchall():\n                if row[1]:\n                    file_meta[Path(row[1]).name] = (row[0] or \"\", row[2] or \"\")\n        except Exception:\n            pass\n\n        ef_csv_candidates = [\n            evidence_path.parent / \"evidence_files.csv\",\n            Path(\"dataset/evidence_files.csv\"),\n        ]\n        for ef_csv in ef_csv_candidates:\n            if ef_csv.is_file():\n                try:\n                    with ef_csv.open(\"r\", encoding=\"utf-8-sig\", newline=\"\") as f:\n                        for row in csv.DictReader(f):\n                            fp = row.get(\"file_path\")\n                            if fp:\n                                file_meta[Path(fp).name] = (\n                                    row.get(\"file_id\", \"\"),\n                                    row.get(\"captured_at\", \"\"),\n                                )\n                    break\n                except Exception:\n                    pass\n\n        # Load identity resolution mappings\n        email_to_user: Dict[str, str] = {}\n        user_to_email: Dict[str, str] = {}\n        try:\n            for r in conn.execute(\n                \"SELECT user_id, email FROM user_identities WHERE user_id IS NOT NULL AND email IS NOT NULL\"\n            ).fetchall():\n                if r[0] and r[1]:\n                    email_to_user[r[1].lower().strip()] = r[0].strip()\n                    user_to_email[r[0].strip()] = r[1].strip()\n        except Exception:\n            pass\n\n        for candidate in [\n            evidence_path.parent / \"user_identities.csv\",\n            Path(\"dataset/user_identities.csv\"),\n        ]:\n            if candidate.is_file():\n                try:\n                    with candidate.open(\"r\", encoding=\"utf-8-sig\", newline=\"\") as f:\n                        for row in csv.DictReader(f):\n                            uid = row.get(\"user_id\")\n                            eml = row.get(\"email\")\n                            if uid and eml:\n                                email_to_user[eml.lower().strip()] = uid.strip()\n                                user_to_email[uid.strip()] = eml.strip()\n                    break\n                except Exception:\n                    pass\n\n        merged_records: Dict[str, Tuple[str, str, str, str, str, Optional[str], Optional[str]]] = {}\n\n        def record_finding(\n            fid: str,\n            cap: str,\n            sys_id: Optional[str],\n            res_id: str,\n            state: Optional[str],\n            uid: Optional[str],\n            eml: Optional[str],\n        ) -> None:\n            if not res_id:\n                return\n            sys_id = _clean_str(sys_id) or \"\"\n            uid = _clean_str(uid)\n            eml = _clean_str(eml)\n\n            if eml and \"@\" not in eml:\n                if not uid and eml.startswith(\"user_\"):\n                    uid = eml\n                    eml = None\n\n            if eml and not uid:\n                uid = email_to_user.get(eml.lower())\n            if uid and not eml:\n                eml = user_to_email.get(uid)\n\n            if res_id in merged_records:\n                old_fid, old_cap, old_sys, _, old_state, old_uid, old_eml = merged_records[res_id]\n                fid = fid or old_fid\n                cap = cap or old_cap\n                sys_id = sys_id or old_sys\n                uid = uid or old_uid\n                eml = eml or old_eml\n                state = state or old_state\n\n            merged_records[res_id] = (\n                fid or \"\",\n                cap or \"\",\n                sys_id,\n                res_id,\n                state or \"PRESENT\",\n                uid,\n                eml,\n            )\n\n        # 2. TWO-PASS TRACE CORRELATION FOR LOGS\n        logs_dir = evidence_path / \"logs\"\n        if logs_dir.is_dir():\n            for log_file in sorted(logs_dir.glob(\"*.log\")):\n                fid, cap = file_meta.get(log_file.name, (\"\", \"\"))\n                trace_groups: Dict[str, List[Dict[str, Any]]] = {}\n\n                try:\n                    with log_file.open(\"r\", encoding=\"utf-8\", errors=\"ignore\") as f:\n                        for line_idx, line in enumerate(f):\n                            line = line.strip()\n                            if not line:\n                                continue\n\n                            entry: Dict[str, Any] = {}\n                            j_start = line.find(\"{\")\n                            if j_start != -1 and line.endswith(\"}\"):\n                                try:\n                                    entry = json.loads(line[j_start:])\n                                except Exception:\n                                    pass\n                            elif \"=\" in line:\n                                for m in KV_REGEX.findall(line):\n                                    k = m[0]\n                                    v = m[1] if m[1] != \"\" else m[2]\n                                    entry[k] = v\n\n                            trace_id = entry.get(\"trace_id\") or entry.get(\"requestId\")\n                            if not trace_id:\n                                trace_id = f\"__no_trace__{log_file.stem}_{line_idx}\"\n\n                            trace_groups.setdefault(str(trace_id), []).append(entry)\n                except Exception:\n                    continue\n\n                for trace_id, entries in trace_groups.items():\n                    # Pass 1: Extract Identifiers per trace\n                    trace_email: Optional[str] = None\n                    trace_user_id: Optional[str] = None\n\n                    for entry in entries:\n                        for k in (\n                            \"lookup_key\",\n                            \"subject_ref\",\n                            \"subject_reference\",\n                            \"email\",\n                            \"customer_email\",\n                            \"requester_email\",\n                            \"match_key\",\n                            \"correlation_key\",\n                        ):\n                            val = entry.get(k)\n                            if val is not None:\n                                val_str = str(val).strip()\n                                if not val_str or val_str.lower() in (\"null\", \"none\"):\n                                    continue\n                                if \"@\" in val_str and not trace_email:\n                                    trace_email = val_str\n                                if val_str.startswith(\"user_\") and not trace_user_id:\n                                    trace_user_id = val_str\n\n                    if trace_email and not trace_user_id:\n                        trace_user_id = email_to_user.get(trace_email.lower())\n                    if trace_user_id and not trace_email:\n                        trace_email = user_to_email.get(trace_user_id)\n\n                    # Pass 2: Extract Resources and assign identifiers\n                    for entry in entries:\n                        res_id = _clean_str(entry.get(\"resource_id\"))\n                        if not res_id:\n                            continue\n\n                        sys_id = (\n                            entry.get(\"service\")\n                            or entry.get(\"system\")\n                            or entry.get(\"system_id\")\n                            or entry.get(\"logger\")\n                        )\n                        if sys_id:\n                            sys_id = str(sys_id).strip()\n                        else:\n                            if res_id.startswith(\"analytics_\"):\n                                sys_id = \"analytics_platform\"\n                            elif res_id.startswith(\"account_\"):\n                                sys_id = \"account_service\"\n                            elif res_id.startswith(\"audit_record_\"):\n                                sys_id = \"security_service\"\n                            elif res_id.startswith(\"search_\"):\n                                sys_id = \"search_service\"\n                            elif res_id.startswith(\"support_\"):\n                                sys_id = \"support_platform\"\n                            elif res_id.startswith(\"export_\"):\n                                sys_id = \"export_service\"\n                            elif res_id.startswith(\"backup_\"):\n                                sys_id = \"backup_service\"\n                            elif res_id.startswith(\"data_flow_\"):\n                                sys_id = \"integration_service\"\n\n                        rows_val = str(entry.get(\"rows\") if entry.get(\"rows\") is not None else \"\").strip()\n                        status_val = str(\n                            entry.get(\"http_status\") if entry.get(\"http_status\") is not None else \"\"\n                        ).strip()\n                        event_val = str(entry.get(\"event\") or \"\")\n                        integrity_val = st