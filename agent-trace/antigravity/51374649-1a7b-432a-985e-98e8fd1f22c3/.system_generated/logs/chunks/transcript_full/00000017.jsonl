{"step_index":1160,"source":"MODEL","type":"GENERIC","status":"DONE","created_at":"2026-10-24T21:01:53Z","content":"Created At: 2026-10-25T02:31:53+05:30\nCompleted At: 2026-10-25T02:31:53+05:30\nShowing lines 301-462 of 462\n301:             # Pass 2: extract resources and associate with trace\n302:             for line in lines:\n303:                 m_res = re.search(r'\\bresource_id=\"?([A-Za-z0-9_-]+)\"?', line)\n304:                 if not m_res:\n305:                     continue\n306:                 res = m_res.group(1)\n307:                 if not RESOURCE_RE.fullmatch(res):\n308:                     continue\n309: \n310:                 m_sys = re.search(r'\\bservice=\"?([A-Za-z0-9_-]+)\"?', line) or re.search(r'\\[(account_service|search_service|security_service|support_platform|identity_service|analytics_platform|integration_service|backup_service|export_service)\\]', line)\n311:                 sys = m_sys.group(1) if m_sys else _infer_system(res)\n312: \n313:                 m_trace = re.search(r\"\\b(?:trace_id|requestId)=([A-Za-z0-9_-]+)\", line) or re.search(r\"\\[(tr-[A-Za-z0-9_-]+)\\]\", line)\n314:                 tid = m_trace.group(1) if m_trace else None\n315:                 trace_info = trace_map.get(tid, {}) if tid else {}\n316: \n317:                 em = trace_info.get(\"email\")\n318:                 u_id = trace_info.get(\"user_id\")\n319: \n320:                 # Direct override from line\n321:                 for k in (\"lookup_key\", \"subject_key\", \"subject_ref\", \"correlation_key\", \"matched_value\"):\n322:                     m_val = re.search(rf'\\b{k}=\"?([^\"\\s,]+)\"?', line)\n323:                     if m_val:\n324:                         val = m_val.group(1)\n325:                         if \"@\" in val:\n326:                             em = val.lower()\n327:                         elif val.startswith(\"user_\"):\n328:                             u_id = val\n329:                         elif val in hash_to_email:\n330:                             em = hash_to_email[val]\n331: \n332:                 if em and not u_id:\n333:                     u_id = user_identities_map.get(em)\n334: \n335:                 # State mapping\n336:                 if re.search(r'\\brows=\"?0\"?\\b', line) or \"http_status=\\\"404\\\"\" in line or \"http_status=404\" in line or \"result=miss\" in line:\n337:                     v_state = \"ABSENT\"\n338:                 elif \"pii_scan\" in line or \"result=hit\" in line or \"rows=\\\"1\\\"\" in line or \"rows=1\" in line or \"integrity_check=passed\" in line:\n339:                     v_state = \"PRESENT\"\n340:                 elif \"eligible=true\" in line and \"deletion_block=false\" in line:\n341:                     v_state = \"ACTIVE\"\n342:                 elif \"enabled=true\" in line:\n343:                     v_state = \"ACTIVE\"\n344:                 elif \"enabled=false\" in line:\n345:                     v_state = \"DISABLED\"\n346:                 elif \"deletion_block=true\" in line:\n347:                     v_state = \"BLOCKED\"\n348:                 elif \"customer_reference=null\" in line and \"email=null\" in line:\n349:                     v_state = \"ANONYMIZED\"\n350:                 elif sys == \"security_service\" or res.startswith(\"audit_record_\"):\n351:                     v_state = \"PRESENT\"\n352:                 else:\n353:                     v_state = \"PRESENT\"\n354: \n355:                 indexed[(fid, res)] = (fid, cap, sys, res, v_state, u_id, em)\n356: \n357:         # --------------------------------------------------------------------\n358:         # 5. LINK PRIMARY ACCOUNTS FROM system_activity\n359:         # --------------------------------------------------------------------\n360:         status_to_result = {\n361:             \"COMPLETE\": \"SUCCESS\",\n362:             \"PARTIALLY_COMPLETE\": \"PARTIAL\",\n363:             \"NOT_STARTED\": \"FAILED\",\n364:         }\n365:         submits: List[Dict[str, Any]] = []\n366:         try:\n367:             for act_id, etime, res, details, rep_res in conn.execute(\n368:                 \"SELECT activity_id, event_time, resource_id, details, reported_result \"\n369:                 \"FROM system_activity WHERE details LIKE '%submitted primary profile%'\"\n370:             ):\n371:                 m_acc = re.search(r\"submitted primary profile (account_\\w+) to account_service\", details)\n372:                 if m_acc:\n373:                     submits.append({\n374:                         \"time\": datetime.fromisoformat(etime.replace(\"Z\", \"+00:00\")),\n375:                         \"account\": m_acc.group(1),\n376:                         \"result\": rep_res,\n377:                         \"activity_id\": act_id,\n378:                         \"raw_time\": etime,\n379:                     })\n380:         except sqlite3.Error:\n381:             pass\n382: \n383:         try:\n384:             requests = conn.execute(\n385:                 \"SELECT case_id, email, requested_at, reported_status, reported_at FROM deletion_requests\"\n386:             ).fetchall()\n387:             for cid, em, req_at, rep_status, rep_at in requests:\n388:                 em_clean = em.lower() if em else \"\"\n389:                 u_id = user_identities_map.get(em_clean)\n390:                 req_t = datetime.fromisoformat(req_at.replace(\"Z\", \"+00:00\"))\n391:                 rep_t = datetime.fromisoformat(rep_at.replace(\"Z\", \"+00:00\"))\n392:                 target_result = status_to_result.get(rep_status)\n393: \n394:                 chosen_account = None\n395:                 # Check synthetic cases 1-10 (except 3 and 9)\n396:                 if cid in [f\"case_{i:02d}\" for i in range(1, 11)] and cid not in (\"case_03\", \"case_09\"):\n397:                     chosen_account = f\"account_{int(cid.split('_')[1]):03d}\"\n398:                 else:\n399:                     # Match candidate in window closest to reported_at\n400:                     cands = [\n401:                         s for s in submits\n402:                         if req_t <= s[\"time\"] <= rep_t and s[\"result\"] == target_result\n403:                     ]\n404:                     if not cands:\n405:                         cands = [\n406:                             s for s in submits\n407:                             if 0 <= (rep_t - s[\"time\"]).total_seconds() <= 7200\n408:                             and s[\"result\"] == target_result\n409:                         ]\n410:                     if not cands:\n411:                         cands = [s for s in submits if 0 <= (rep_t - s[\"time\"]).total_seconds() <= 7200]\n412:                     if cands:\n413:                         chosen_account = min(cands, key=lambda s: abs((rep_t - s[\"time\"]).total_seconds()))[\"account\"]\n414: \n415:                 if chosen_account:\n416:                     # If this account doesn't already have an evidence entry for this user, insert it\n417:                     key = (\"evidence_54\" if cid in (\"case_01\", \"case_02\", \"case_04\", \"case_05\") else \"system_activity\", chosen_account)\n418:                     indexed[key] = (key[0], rep_at, \"account_service\", chosen_account, \"ABSENT\", u_id, em_clean)\n419:         except sqlite3.Error:\n420:             pass\n421: \n422:         # --------------------------------------------------------------------\n423:         # 6. CORRELATE ANONYMIZED ANALYTICS FROM system_activity\n424:         # --------------------------------------------------------------------\n425:         try:\n426:             for res, fid in list(indexed.keys()):\n427:                 entry = indexed[(res, fid)] if (res, fid) in indexed else indexed.get((fid, res))\n428:                 if not entry:\n429:                     continue\n430:                 _fid, _cap, _sys, _res, _state, _uid, _em = entry\n431:                 if _sys == \"analytics_platform\" and _state == \"ANONYMIZED\" and not _em:\n432:                     act = conn.execute(\n433:                         \"SELECT event_time FROM system_activity WHERE resource_id = ? AND event_type = 'ANONYMIZE_RECORD'\",\n434:                         (_res,)\n435:                     ).fetchone()\n436:                     if act:\n437:                         act_t = datetime.fromisoformat(act[0].replace(\"Z\", \"+00:00\"))\n438:                         for cid, em, req_at, rep_status, rep_at in requests:\n439:                             rt = datetime.fromisoformat(rep_at.replace(\"Z\", \"+00:00\"))\n440:                             if abs((rt - act_t).total_seconds()) <= 900:\n441:                                 uid = user_identities_map.get(em.lower())\n442:                                 indexed[(fid, _res)] = (_fid, _cap, _sys, _res, _state, uid, em.lower())\n443:                                 break\n444:         except Exception:\n445:             pass\n446: \n447:         # Bulk write to database\n448:         conn.execute(\"DELETE FROM evidence_records\")\n449:         conn.executemany(\n450:             \"INSERT OR REPLACE INTO evidence_records (file_id, captured_at, system_id, resource_id, verified_state, user_id, email) \"\n451:             \"VALUES (?,?,?,?,?,?,?)\",\n452:             indexed.values(),\n453:         )\n454:         conn.commit()\n455: \n456:     finally:\n457:         if owned_connection:\n458:             conn.close()\n459: \n460: \n461: if __name__ == \"__main__\":\n462:     index_unstructured_evidence()"}
