{"step_index":1156,"source":"MODEL","type":"GENERIC","status":"DONE","created_at":"2026-10-24T21:01:46Z","content":"Created At: 2026-10-25T02:31:46+05:30\nCompleted At: 2026-10-25T02:31:46+05:30\nShowing lines 1-100 of 462\n1: #!/usr/bin/env python3\n2: \"\"\"Index participant-facing evidence files into the Northstar SQLite cache.\"\"\"\n3: \n4: from __future__ import annotations\n5: \n6: import csv\n7: import json\n8: import re\n9: import sqlite3\n10: from datetime import datetime\n11: from pathlib import Path\n12: from typing import Any, Dict, Iterable, List, Optional, Set, Tuple\n13: \n14: SUPPORTED_EXTENSIONS = {\".log\", \".json\", \".sql\", \".csv\", \".txt\"}\n15: RESOURCE_RE = re.compile(\n16:     r\"\\b(?:account|search|security|audit_record|support|identity|analytics|\"\n17:     r\"telemetry|data_flow|backup|export|tombstone|customer)[_-][A-Za-z0-9_-]+\\b\",\n18:     re.IGNORECASE,\n19: )\n20: KEY_VALUE_RE = re.compile(r'''([\\w.-]+)\\s*[:=]\\s*(?:\"([^\"]*)\"|'([^']*)'|([^,\\s}]+))''')\n21: \n22: \n23: def _text(path: Path) -> str:\n24:     try:\n25:         return path.read_text(encoding=\"utf-8-sig\", errors=\"replace\")\n26:     except OSError:\n27:         return \"\"\n28: \n29: \n30: def _infer_system(resource: str, explicit_sys: str = \"\") -> str:\n31:     if explicit_sys:\n32:         return explicit_sys.strip()\n33:     r = resource.casefold()\n34:     if r.startswith(\"account_\") or r.startswith(\"customer_\"):\n35:         return \"account_service\"\n36:     if r.startswith(\"search_\"):\n37:         return \"search_service\"\n38:     if r.startswith(\"audit_record_\") or r.startswith(\"security_\"):\n39:         return \"security_service\"\n40:     if r.startswith(\"support_\"):\n41:         return \"support_platform\"\n42:     if r.startswith(\"identity_\") or r.startswith(\"tombstone_\"):\n43:         return \"identity_service\"\n44:     if r.startswith(\"analytics_\") or r.startswith(\"telemetry_\"):\n45:         return \"analytics_platform\"\n46:     if r.startswith(\"data_flow_\"):\n47:         return \"integration_service\"\n48:     if r.startswith(\"backup_\"):\n49:         return \"backup_service\"\n50:     if r.startswith(\"export_\"):\n51:         return \"export_service\"\n52:     return \"\"\n53: \n54: \n55: def index_unstructured_evidence(\n56:     evidence_dir: Path = Path(\"dataset/evidence\"),\n57:     conn: Optional[sqlite3.Connection] = None,\n58: ) -> None:\n59:     \"\"\"Recursively index supported evidence formats, retaining file-level provenance.\"\"\"\n60:     evidence_path = Path(evidence_dir)\n61:     owned_connection = conn is None\n62:     if conn is None:\n63:         db_path = Path(\"cache/northstar.db\")\n64:         db_path.parent.mkdir(parents=True, exist_ok=True)\n65:         conn = sqlite3.connect(db_path)\n66: \n67:     try:\n68:         conn.execute(\n69:             \"CREATE TABLE IF NOT EXISTS evidence_records (\"\n70:             \"file_id TEXT NOT NULL, captured_at TEXT, system_id TEXT, \"\n71:             \"resource_id TEXT NOT NULL, verified_state TEXT, user_id TEXT, email TEXT, \"\n72:             \"PRIMARY KEY(file_id, resource_id))\"\n73:         )\n74:         conn.execute(\"CREATE INDEX IF NOT EXISTS idx_ev_res ON evidence_records(resource_id)\")\n75:         conn.execute(\"CREATE INDEX IF NOT EXISTS idx_ev_user ON evidence_records(user_id)\")\n76:         conn.execute(\"CREATE INDEX IF NOT EXISTS idx_ev_email ON evidence_records(email)\")\n77: \n78:         file_manifest: Dict[str, Tuple[str, str]] = {}\n79:         try:\n80:             for fid, fpath, cap in conn.execute(\n81:                 \"SELECT file_id, file_path, captured_at FROM evidence_files\"\n82:             ):\n83:                 if fpath:\n84:                     file_manifest[Path(str(fpath)).name.casefold()] = (\n85:                         str(fid or \"\"), str(cap or \"\")\n86:                     )\n87:         except sqlite3.Error:\n88:             pass\n89: \n90:         manifest_file = evidence_path.parent / \"evidence_files.csv\"\n91:         if manifest_file.is_file():\n92:             with manifest_file.open(\"r\", encoding=\"utf-8-sig\", newline=\"\") as src:\n93:                 for row in csv.DictReader(src):\n94:                     fp = row.get(\"file_path\")\n95:                     if fp:\n96:                         file_manifest[Path(fp).name.casefold()] = (\n97:                             str(row.get(\"file_id\") or \"\"),\n98:                             str(row.get(\"captured_at\") or \"\"),\n99:                         )\n100: "}
