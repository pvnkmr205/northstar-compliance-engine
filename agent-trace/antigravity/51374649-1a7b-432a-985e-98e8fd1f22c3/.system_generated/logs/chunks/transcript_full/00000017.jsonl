{"step_index":1158,"source":"MODEL","type":"GENERIC","status":"DONE","created_at":"2026-10-24T21:01:49Z","content":"Created At: 2026-10-25T02:31:49+05:30\nCompleted At: 2026-10-25T02:31:49+05:30\nShowing lines 101-300 of 462\n101:         user_identities_map: Dict[str, str] = {}\n102:         hash_to_email: Dict[str, str] = {}\n103:         try:\n104:             for uid, em, eh in conn.execute(\n105:                 \"SELECT user_id, email, email_hash FROM user_identities WHERE email IS NOT NULL\"\n106:             ):\n107:                 if em and uid:\n108:                     user_identities_map[em.strip().lower()] = uid.strip()\n109:                 if eh and em:\n110:                     hash_to_email[eh.strip()] = em.strip().lower()\n111:         except sqlite3.Error:\n112:             pass\n113: \n114:         indexed: Dict[Tuple[str, str], Tuple[str, str, str, str, str, Optional[str], Optional[str]]] = {}\n115: \n116:         # --------------------------------------------------------------------\n117:         # 1. TEXT HANDOVER LOGS (*.txt)\n118:         # --------------------------------------------------------------------\n119:         for p in evidence_path.rglob(\"*.txt\"):\n120:             fid, cap = file_manifest.get(p.name.casefold(), (\"evidence_03\", \"2026-10-01T12:00:00Z\"))\n121:             for line in _text(p).splitlines():\n122:                 line = line.strip()\n123:                 if not line or \"|\" not in line:\n124:                     continue\n125:                 parts = [part.strip().strip(\"- \") for part in line.split(\"|\")]\n126:                 if len(parts) >= 6:\n127:                     ts, sys, res, cat, status, target = parts[:6]\n128:                     st = status.upper()\n129:                     if st in (\"NOT_FOUND\", \"DELETED\"):\n130:                         v_state = \"ABSENT\"\n131:                     elif st == \"ANONYMIZED\":\n132:                         v_state = \"ANONYMIZED\"\n133:                     elif st == \"REDACTED\":\n134:                         v_state = \"REDACTED\"\n135:                     elif st in (\"ACTIVE\",):\n136:                         v_state = \"ACTIVE\"\n137:                     elif st in (\"DISABLED\",):\n138:                         v_state = \"DISABLED\"\n139:                     elif st in (\"BLOCKED\",):\n140:                         v_state = \"BLOCKED\"\n141:                     else:\n142:                         v_state = \"PRESENT\"\n143: \n144:                     u_id = target if target.startswith(\"user_\") else None\n145:                     em = target.lower() if \"@\" in target else None\n146:                     if em and not u_id:\n147:                         u_id = user_identities_map.get(em)\n148:                     indexed[(fid, res)] = (fid, ts, sys, res, v_state, u_id, em)\n149: \n150:         # --------------------------------------------------------------------\n151:         # 2. SQL REPLICA DUMPS (*.sql)\n152:         # --------------------------------------------------------------------\n153:         insert_pattern = re.compile(\n154:             r\"INSERT INTO \\\"(?P<table>\\w+)\\\" VALUES\\('(?P<res>[^']+)',\\s*'(?P<sys>[^']+)',\\s*'(?P<col>[^']+)',\\s*'(?P<payload>\\{.*?\\})'\",\n155:             re.DOTALL,\n156:         )\n157:         for p in evidence_path.rglob(\"*.sql\"):\n158:             fid, cap = file_manifest.get(p.name.casefold(), (\"\", \"\"))\n159:             if not fid:\n160:                 continue\n161:             content = _text(p)\n162:             for match in insert_pattern.finditer(content):\n163:                 res = match.group(\"res\")\n164:                 sys = match.group(\"sys\")\n165:                 try:\n166:                     payload = json.loads(match.group(\"payload\"))\n167:                 except Exception:\n168:                     continue\n169:                 u_id = (\n170:                     payload.get(\"subject_reference\")\n171:                     or payload.get(\"user_id\")\n172:                     or payload.get(\"customer_reference\")\n173:                 )\n174:                 em = payload.get(\"email\") or payload.get(\"requester_email\") or payload.get(\"customer_email\")\n175:                 if em:\n176:                     em = em.lower()\n177:                 if u_id and \"@\" in u_id:\n178:                     em, u_id = u_id.lower(), None\n179:                 if em and not u_id:\n180:                     u_id = user_identities_map.get(em)\n181: \n182:                 if sys == \"security_service\" or res.startswith(\"audit_record_\"):\n183:                     v_state = \"PRESENT\"\n184:                 elif \"status_code\" in payload and payload[\"status_code\"] == 404:\n185:                     v_state = \"ABSENT\"\n186:                 elif payload.get(\"profile\") is None and sys == \"account_service\":\n187:                     v_state = \"ABSENT\"\n188:                 elif any(payload.get(k) for k in (\"email\", \"phone\", \"full_name\", \"first_name\")):\n189:                     v_state = \"PRESENT\"\n190:                 else:\n191:                     v_state = \"ANONYMIZED\"\n192: \n193:                 indexed[(fid, res)] = (fid, cap, sys, res, v_state, u_id, em)\n194: \n195:         # --------------------------------------------------------------------\n196:         # 3. SNAPSHOT BUNDLE JSONs (*.json)\n197:         # --------------------------------------------------------------------\n198:         for p in evidence_path.rglob(\"*.json\"):\n199:             fid, cap = file_manifest.get(p.name.casefold(), (\"\", \"\"))\n200:             if not fid:\n201:                 continue\n202:             try:\n203:                 data = json.loads(_text(p))\n204:             except Exception:\n205:                 continue\n206: \n207:             if isinstance(data, dict) and \"snapshots\" in data:\n208:                 for snap in data[\"snapshots\"]:\n209:                     sys = snap.get(\"system_id\") or snap.get(\"service\")\n210:                     for rec in snap.get(\"records\", []):\n211:                         res = rec.get(\"resource_id\") or rec.get(\"record_id\")\n212:                         if not res:\n213:                             continue\n214:                         u_id = rec.get(\"subject_reference\") or rec.get(\"user_id\") or rec.get(\"customer_reference\")\n215:                         em = rec.get(\"email\") or rec.get(\"requester_email\")\n216:                         if em:\n217:                             em = em.lower()\n218:                         if u_id and \"@\" in u_id:\n219:                             em, u_id = u_id.lower(), None\n220:                         if em and not u_id:\n221:                             u_id = user_identities_map.get(em)\n222: \n223:                         if not sys:\n224:                             sys = _infer_system(res)\n225: \n226:                         if sys == \"security_service\" or res.startswith(\"audit_record_\"):\n227:                             v_state = \"PRESENT\"\n228:                         elif rec.get(\"status_code\") == 404 or rec.get(\"result\") in (\"not_found\", \"deleted\"):\n229:                             v_state = \"ABSENT\"\n230:                         elif any(rec.get(k) for k in (\"email\", \"requester_email\", \"phone\", \"full_name\")):\n231:                             v_state = \"PRESENT\"\n232:                         else:\n233:                             v_state = \"ANONYMIZED\"\n234: \n235:                         indexed[(fid, res)] = (fid, cap, sys, res, v_state, u_id, em)\n236: \n237:             elif isinstance(data, dict) and \"service_exports\" in data:\n238:                 for sys_name, export_data in data[\"service_exports\"].items():\n239:                     for list_key, items in export_data.items():\n240:                         if not isinstance(items, list):\n241:                             continue\n242:                         for item in items:\n243:                             res = item.get(\"resource_id\")\n244:                             if not res:\n245:                                 continue\n246:                             prof = item.get(\"profile\") or item\n247:                             em = prof.get(\"email\") if isinstance(prof, dict) else None\n248:                             u_id = prof.get(\"customer_reference\") or prof.get(\"subject_reference\") if isinstance(prof, dict) else None\n249:                             if em:\n250:                                 em = em.lower()\n251:                             if u_id and \"@\" in u_id:\n252:                                 em, u_id = u_id.lower(), None\n253:                             if em and not u_id:\n254:                                 u_id = user_identities_map.get(em)\n255: \n256:                             code = item.get(\"status_code\")\n257:                             if code == 404 or prof is None:\n258:                                 v_state = \"ABSENT\"\n259:                             elif code == 200:\n260:                                 v_state = \"PRESENT\"\n261:                             elif sys_name == \"security_service\" or res.startswith(\"audit_record_\"):\n262:                                 v_state = \"PRESENT\"\n263:                             elif em:\n264:                                 v_state = \"PRESENT\"\n265:                             else:\n266:                                 v_state = \"ANONYMIZED\"\n267: \n268:                             indexed[(fid, res)] = (fid, cap, sys_name, res, v_state, u_id, em)\n269: \n270:         # --------------------------------------------------------------------\n271:         # 4. TWO-PASS TRACE CORRELATION FOR LOGS (*.log)\n272:         # --------------------------------------------------------------------\n273:         for p in evidence_path.rglob(\"*.log\"):\n274:             fid, cap = file_manifest.get(p.name.casefold(), (\"\", \"\"))\n275:             if not fid:\n276:                 continue\n277:             lines = _text(p).splitlines()\n278: \n279:             # Pass 1: extract trace identifiers\n280:             trace_map: Dict[str, Dict[str, Optional[str]]] = {}\n281:             for line in lines:\n282:                 m_trace = re.search(r\"\\b(?:trace_id|requestId)=([A-Za-z0-9_-]+)\", line)\n283:                 if not m_trace:\n284:                     m_trace = re.search(r\"\\[(tr-[A-Za-z0-9_-]+)\\]\", line)\n285:                 if not m_trace:\n286:                     continue\n287:                 tid = m_trace.group(1)\n288:                 entry = trace_map.setdefault(tid, {\"email\": None, \"user_id\": None})\n289: \n290:                 for k in (\"lookup_key\", \"subject_key\", \"subject_ref\", \"subject_reference\", \"email\", \"correlation_key\", \"matched_value\"):\n291:                     m_val = re.search(rf'\\b{k}=\"?([^\"\\s,]+)\"?', line)\n292:                     if m_val:\n293:                         val = m_val.group(1)\n294:                         if \"@\" in val and not entry[\"email\"]:\n295:                             entry[\"email\"] = val.lower()\n296:                         elif val.startswith(\"user_\") and not entry[\"user_id\"]:\n297:                             entry[\"user_id\"] = val\n298:                         elif val in hash_to_email and not entry[\"email\"]:\n299:                             entry[\"email\"] = hash_to_email[val]\n300: "}
