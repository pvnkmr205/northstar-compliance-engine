{"step_index":639,"source":"MODEL","type":"GENERIC","status":"DONE","created_at":"2026-10-24T19:58:37Z","content":"Created At: 2026-10-25T01:28:37+05:30\nCompleted At: 2026-10-25T01:28:37+05:30\nShowing lines 1-60 of 2089\n1: #!/usr/bin/env python3\r\n2: \"\"\"\r\n3: Northstar Shop — Ghost Data Audit Engine (pipeline.py)\r\n4: Hybrid Neuro-Symbolic Architecture for 24-Hour Hackathon Execution.\r\n5: \r\n6: Features included:\r\n7: 1. Deterministic `steps_json` Sorting & Validation Engine (15 Allowed Operations).\r\n8: 2. Multi-Model Token & Cost Telemetry Wrapper (`evaluation/usage_report.md`).\r\n9: 3. Zero-Token SQLite Ingestion & Identity Resolution (Transitive Closure).\r\n10: 4. Cross-Case `EvidenceVault` Cache & Batched Intent Classification hooks.\r\n11: \"\"\"\r\n12: \r\n13: from __future__ import annotations\r\n14: \r\n15: import csv\r\n16: import hashlib\r\n17: import json\r\n18: import sqlite3\r\n19: from dataclasses import dataclass, field\r\n20: from pathlib import Path\r\n21: from typing import Any, Callable, Dict, List, Optional, Set, Tuple\r\n22: \r\n23: # ============================================================================\r\n24: # 1. ALLOWED OPERATIONS & DETERMINISTIC ORDERING SPEC\r\n25: # ============================================================================\r\n26: \r\n27: PHASE_ORDER: Dict[str, int] = {\n28:     \"FINDING\": 0,\r\n29:     \"REMEDIATION\": 1,\r\n30:     \"VERIFICATION\": 2,\r\n31: }\n32: \n33: SYSTEM_ORDER: Dict[str, int] = {\n34:     \"account_service\": 1,\n35:     \"search_service\": 2,\n36:     \"security_service\": 3,\n37:     \"support_platform\": 4,\n38:     \"identity_service\": 5,\n39:     \"analytics_platform\": 6,\n40:     \"integration_service\": 7,\n41:     \"backup_service\": 8,\n42:     \"export_service\": 9,\n43: }\n44: \r\n45: # Exact table order from problem_statement.md: (phase, operation) -> (op_rank, required_state)\r\n46: ALLOWED_OPERATIONS: Dict[Tuple[str, str], Tuple[int, str]] = {\r\n47:    