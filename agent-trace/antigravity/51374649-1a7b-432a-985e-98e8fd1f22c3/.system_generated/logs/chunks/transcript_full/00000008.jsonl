74:                         file_meta[Path(file_path).name.casefold()] = (\n175:                             str(row.get(\"file_id\") or \"\"),\n176:                             str(row.get(\"captured_at\") or \"\"),\n177:                         )\n178: \n179:         email_to_user: Dict[str, str] = {}\n180:         try:\n181:             email_to_user.update({\n182:                 str(email).strip().casefold(): str(user_id).strip()\n183:                 for user_id, email in conn.execute(\n184:                     \"SELECT user_id,email FROM user_identities WHERE user_id IS NOT NULL AND email IS NOT NULL\"\n185:                 ) if email and user_id\n186:             })\n187:         except sqlite3.Error:\n188:             pass\n189: \n190:         indexed: Dict[tuple[str, str], tuple[str, str, str, str, str, Optional[str], Optional[str]]] = {}\n191:         for path in sorted(evidence_path.rglob(\"*\")):\n192:             if not path.is_file() or path.suffix.casefold() not in SUPPORTED_EXTENSIONS:\n193:                 continue\n194:             file_id, captured_at = file_meta.get(path.name.casefold(), (\"\", \"\"))\n195:             content = _text(path)\n196:             candidates: Iterable[Dict[str, Any]]\n197:             if path.suffix.casefold() == \".json\":\n198:                 try:\n199:                     candidates = list(_records_from_json(json.loads(content)))\n200:                 except json.JSONDecodeError:\n201:                     candidates = [_parse_line(line) for line in content.splitlines()]\n202:             elif path.suffix.casefold() == \".csv\":\n203:                 try:\n204:                     candidates = list(csv.DictReader(content.splitlines()))\n205:                 except csv.Error:\n206:                     candidates = [_parse_line(line) for line in content.splitlines()]\n207:             elif path.suffix.casefold() == \".sql\":\n208:                 candidates_list: list[Dict[str, Any]] = []\n209:                 snapshot = sqlite3.connect(\":memory:\")\n210:                 try:\n211:                     snapshot.executescript(content)\n212:                     for (table_name,) in snapshot.execute(\n213:                         \"SELECT name FROM sqlite_master WHERE type='table' AND name NOT LIKE 'sqlite_%'\"\n214:                     ):\n215:                         table_columns = [row[1] for row in snapshot.execute(\n216:                             f'PRAGMA table_info(\"{str(table_name).replace(chr(34), chr(34) * 2)}\")'\n217:                         )]\n218:                         if not table_columns:\n219:                             continue\n220:                         quoted = str(table_name).replace('\"', '\"\"')\n221:                         for values in snapshot.execute(f'SELECT * FROM \"{quoted}\"'):\n222:                             item = {str(key).casefold(): value for key, value in zip(table_columns, values)}\n223:                             resource_key = next((key for key in\n224:                                                  (\"resource_id\", \"record_id\", \"account_id\", \"id\")\n225:                                                  if item.get(key)), None)\n226:                             if resource_key:\n227:                                 resource_value = str(item[resource_key]).strip()\n228:                                 if not RESOURCE_RE.fullmatch(resource_value):\n229:                                     continue\n230:                                 item.setdefault(\"system_id\", _system_from_table(str(table_name)))\n231:                                 candidates_list.append(item)\n232:                 except sqlite3.Error:\n233:                     candidates_list = [_parse_line(line) for line in content.splitlines()]\n234:                 finally:\n235:                     snapshot.close()\n236:                 candidates = candidates_list\n237:             else:\n238:                 candidates = [_parse_line(line) for line in conte