{"step_index":318,"source":"MODEL","type":"PLANNER_RESPONSE","status":"DONE","created_at":"2026-10-24T18:41:16Z","input_tokens":4379,"cache_read_tokens":135487,"output_tokens":3450,"tool_calls":[{"name":"write_file","args":{"Content":"#!/usr/bin/env python3\n\"\"\"\nZero-token local evidence indexer for Northstar Shop Deletion Audit dataset.\nParses structured logs and JSON records into SQLite cache/northstar.db.\n\"\"\"\n\nfrom __future__ import annotations\n\nimport csv\nimport json\nimport re\nimport sqlite3\nfrom pathlib import Path\nfrom typing import Any, Dict, Optional, Tuple\n\nKV_REGEX = re.compile(r'(\\w+)=(?:\"([^\"]*)\"|(\\S+))')\n\n\ndef _clean_str(val: Any) -> Optional[str]:\n    if val is None:\n        return None\n    s = str(val).strip()\n    if not s or s.lower() in (\"null\", \"none\"):\n        return None\n    return s\n\n\ndef index_unstructured_evidence(\n    evidence_dir: Path = Path(\"dataset/evidence\"),\n    conn: Optional[sqlite3.Connection] = None,\n) -> None:\n    \"\"\"\n    Parse files in logs/ and records/ and populate evidence_records in SQLite.\n    \"\"\"\n    evidence_path = Path(evidence_dir)\n    close_conn = False\n\n    if conn is None:\n        db_path = Path(\"cache/northstar.db\")\n        db_path.parent.mkdir(parents=True, exist_ok=True)\n        conn = sqlite3.connect(db_path)\n        close_conn = True\n\n    try:\n        conn.execute(\n            \"\"\"\n            CREATE TABLE IF NOT EXISTS evidence_records (\n                file_id TEXT,\n                captured_at TEXT,\n                system_id TEXT,\n                resource_id TEXT PRIMARY KEY,\n                verified_state TEXT,\n                user_id TEXT,\n                email TEXT\n            );\n            \"\"\"\n        )\n        conn.execute(\"CREATE INDEX IF NOT EXISTS idx_ev_res ON evidence_records(resource_id);\")\n        conn.execute(\"CREATE INDEX IF NOT EXISTS idx_ev_user ON evidence_records(user_id);\")\n        conn.execute(\"CREATE INDEX IF NOT EXISTS idx_ev_email ON evidence_records(email);\")\n\n        # Map file basenames to (file_id, captured_at)\n        file_meta: Dict[str, Tuple[str, str]] = {}\n\n        # 1. Try reading from conn evidence_files table\n        try:\n            cur = conn.execute(\"SELECT file_id, file_path, captured_at FROM evidence_files\")\n            for row in cur.fetchall():\n                if row[1]:\n                    bname = Path(row[1]).name\n                    file_meta[bname] = (row[0] or \"\", row[2] or \"\")\n        except Exception:\n            pass\n\n        # 2. Try reading from evidence_files.csv\n        ef_csv_candidates = [\n            evidence_path.parent / \"evidence_files.csv\",\n            Path(\"dataset/evidence_files.csv\"),\n        ]\n        for ef_csv in ef_csv_candidates:\n            if ef_csv.is_file():\n                try:\n                    with ef_csv.open(\"r\", encoding=\"utf-8-sig\", newline=\"\") as f:\n                        for row in csv.DictReader(f):\n                            fp = row.get(\"file_path\")\n                            if fp:\n                                file_meta[Path(fp).name] = (\n                                    row.get(\"file_id\", \"\"),\n                                    row.get(\"captured_at\", \"\"),\n                                )\n                    break\n                except Exception:\n                    pass\n\n        merged_records: Dict[str, Tuple[str, str, str, str, str, Optional[str], Optional[str]]] = {}\n\n        def record_finding(\n            fid: str,\n            cap: str,\n            sys_id: Optional[str],\n            res_id: str,\n            state: Optional[str],\n            uid: Optional[str],\n            eml: Optional[str],\n        ) -> None:\n            if not res_id:\n                return\n            sys_id = _clean_str(sys_id) or \"\"\n            uid = _clean_str(uid)\n            eml = _clean_str(eml)\n            if eml and \"@\" not in eml:\n                if not uid and eml.startswith(\"user_\"):\n                    uid = eml\n                    eml = None\n\n            if res_id in merged_records:\n                old_fid, old_cap, old_sys, _, old_state, old_uid, old_eml = merged_records[res_id]\n                fid = fid or old_fid\n                cap = cap or old_cap\n                sys_id = sys_id or old_sys\n                uid = uid or old_uid\n                eml = eml or old_eml\n                state = state or old_state\n\n            merged_records[res_id] = (\n                fid or \"\",\n                cap or \"\",\n                sys_id,\n                res_id,\n                state or \"PRESENT\",\n                uid,\n                eml,\n            )\n\n        # Process logs\n        logs_dir = evidence_path / \"logs\"\n        if logs_dir.is_dir():\n            for log_file in sorted(logs_dir.glob(\"*.log\")):\n                fid, cap = file_meta.get(log_file.name, (\"\", \"\"))\n                try:\n                    with log_file.open(\"r\", encoding=\"utf-8\", errors=\"ignore\") as f:\n                        for line in f:\n                            line = line.strip()\n                            if not line:\n                                continue\n\n                            # 1. JSON Line Logs\n                            j_start = line.find(\"{\")\n                            if j_start != -1 and line.endswith(\"}\"):\n                                try:\n                                    obj = json.loads(line[j_start:])\n                                    res_id = _clean_str(obj.get(\"resource_id\"))\n                                    if res_id:\n                                        sys_id = obj.get(\"service\") or obj.get(\"system_id\") or obj.get(\"logger\")\n                                        rows_val = str(obj.get(\"rows\", \"\")).strip()\n                                        status_val = str(obj.get(\"http_status\", \"\")).strip()\n                                        uid = (\n                                            obj.get(\"user_id\")\n                                            or obj.get(\"subject_ref\")\n                                            or obj.get(\"customer_reference\")\n                                            or obj.get(\"subject_reference\")\n                                        )\n                                        eml = (\n                                            obj.get(\"email\")\n                                            or obj.get(\"correlation_key\")\n                                            or obj.get(\"lookup_key\")\n                                            or obj.get(\"matched_value\")\n                                        )\n\n                                        if rows_val in (\"0\", \"404\") or status_val == \"404\":\n                                            state = \"ABSENT\"\n                                        elif rows_val in (\"1\", \"200\") or status_val == \"200\":\n                                            state = \"PRESENT\"\n                                        elif not uid and not eml and not obj.get(\"phone\"):\n                                            state = \"ANONYMIZED\"\n                                        else:\n                                            state = \"PRESENT\"\n\n                                        record_finding(fid, cap, sys_id, res_id, state, uid, eml)\n                                        continue\n                                except Exception:\n                                    pass\n\n                            # 2. Key-Value Logs\n                            if \"resource_id=\" in line:\n                                kvs: Dict[str, Optional[str]] = {}\n                                for m in KV_REGEX.findall(line):\n                                    k = m[0]\n                                    v = m[1] if m[1] != \"\" else m[2]\n                                    kvs[k] = _clean_str(v)\n\n                                res_id = kvs.get(\"resource_id\")\n                                if res_id:\n                                    sys_id = kvs.get(\"service\") or kvs.get(\"system\") or kvs.get(\"system_id\")\n                                    rows_val = str(kvs.get(\"rows\") or \"\").strip()\n                                    status_val = str(kvs.get(\"http_status\") or \"\").strip()\n                                    cust_ref = (\n                                        kvs.get(\"customer_reference\")\n                                        or kvs.get(\"subject_reference\")\n                                        or kvs.get(\"user_id\")\n                                    )\n                                    eml = (\n                                        kvs.get(\"email\")\n                                        or kvs.get(\"lookup_key\")\n                                        or kvs.get(\"customer_email\")\n                                        or kvs.get(\"requester_email\")\n                                    )\n                                    res_val = str(kvs.get(\"result\") or \"\").lower()\n\n                                    if (\n                                        (cust_ref is None or cust_ref == \"null\")\n                                        and (eml is None or eml == \"null\")\n                                        and (\n                                            sys_id == \"analytics_platform\"\n                                            or \"analytics\" in (sys_id or \"\")\n                                            or res_id.startswith(\"analytics_\")\n                                        )\n                                    ):\n                                        state = \"ANONYMIZED\"\n                                    elif rows_val == \"0\" or status_val == \"404\" or res_val in (\"miss\", \"not_found\"):\n                                        state = \"ABSENT\"\n                                    elif rows_val == \"1\" or status_val == \"200\" or res_val in (\"hit\", \"found\"):\n                                        state = \"PRESENT\"\n                                    elif kvs.get(\"event\") == \"audit_record_read_completed\":\n                                        state = \"PRESENT\"\n                                    elif (cust_ref is None) and (eml is None):\n                                        state = \"ANONYMIZED\"\n                                    else:\n                                        state = \"PRESENT\"\n\n                                    record_finding(fid, cap, sys_id, res_id, state, cust_ref, eml)\n                except Exception:\n                    pass\n\n        # Process records\n        records_dir = evidence_path / \"records\"\n        if records_dir.is_dir():\n            for rec_file in sorted(records_dir.iterdir()):\n                fid, cap = file_meta.get(rec_file.name, (\"\", \"\"))\n                if rec_file.suffix == \".json\":\n                    try:\n                        data = json.loads(rec_file.read_text(encoding=\"utf-8\", errors=\"ignore\"))\n                        items = []\n                        if isinstance(data, list):\n                            items = data\n                        elif isinstance(data, dict):\n                            for key in (\"records\", \"snapshots\", \"service_exports\"):\n                                if key in data and isinstance(data[key], list):\n                                    items = data[key]\n                                    break\n\n                        for item in items:\n                            if not isinstance(item, dict):\n                                continue\n                            res_id = _clean_str(item.get(\"resource_id\"))\n                            if not res_id:\n                                continue\n\n                            sys_id = item.get(\"system\") or item.get(\"service\") or item.get(\"system_id\")\n                            if not sys_id:\n                                if res_id.startswith(\"analytics_\"):\n                                    sys_id = \"analytics_platform\"\n                                elif res_id.startswith(\"account_\"):\n                                    sys_id = \"account_service\"\n                                elif res_id.startswith(\"audit_record_\"):\n                                    sys_id = \"security_service\"\n                                elif res_id.startswith(\"search_\"):\n                                    sys_id = \"search_service\"\n                                elif res_id.startswith(\"support_\"):\n                                    sys_id = \"support_platform\"\n                                elif res_id.startswith(\"export_\"):\n                                    sys_id = \"export_service\"\n                                elif res_id.startswith(\"backup_\"):\n                                    sys_id = \"backup_service\"\n                                elif res_id.startswith(\"data_flow_\"):\n                                    sys_id = \"integration_service\"\n\n                            uid = item.get(\"user_id\") or item.get(\"customer_reference\") or item.get(\"subject_reference\")\n                            eml = (\n                                item.get(\"email\")\n                                or item.get(\"owner_email\")\n                                or item.get(\"subject_reference\")\n                                or item.get(\"lookup_key\")\n                            )\n\n                            res_val = str(item.get(\"result\") or item.get(\"status\") or \"\").upper()\n                            if res_val in (\"NOT_FOUND\", \"ABSENT\", \"MISS\"):\n                                state = \"ABSENT\"\n                            elif (\n                                not _clean_str(uid)\n                                and not _clean_str(eml)\n                                and not _clean_str(item.get(\"phone\"))\n                                and not _clean_str(item.get(\"email_hash\"))\n                            ):\n                                state = \"ANONYMIZED\"\n                            else:\n                                state = \"PRESENT\"\n\n                            record_finding(fid, cap, sys_id, res_id, state, uid, eml)\n                    except Exception:\n                        pass\n                elif rec_file.suffix == \".txt\":\n                    try:\n                        for line in rec_file.read_text(encoding=\"utf-8\", errors=\"ignore\").splitlines():\n                            if \"|\" in line:\n                                parts = [x.strip() for x in line.split(\"|\")]\n                                if len(parts) >= 5:\n                                    line_sys = parts[1]\n                                    line_res = parts[2]\n                                    line_result = parts[4].upper()\n                                    line_subj = parts[5] if len(parts) > 5 else None\n                                    state = \"ABSENT\" if line_result == \"NOT_FOUND\" else \"PRESENT\"\n                                    uid = line_subj if line_subj and line_subj.startswith(\"user_\") else None\n                                    eml = line_subj if line_subj and \"@\" in line_subj else None\n                                    record_finding(fid, cap, line_sys, line_res, state, uid, eml)\n                    except Exception:\n                        pass\n\n        # Insert or replace extracted facts\n        if merged_records:\n            conn.executemany(\n                \"\"\"\n                INSERT OR REPLACE INTO evidence_records (\n                    file_id, captured_at, system_id, resource_id, verified_state, user_id, email\n                ) VALUES (?, ?, ?, ?, ?, ?, ?)\n                \"\"\",\n                list(merged_records.values()),\n            )\n        conn.commit()\n    finally:\n        if close_conn and conn:\n            conn.close()\n\n\nif __name__ == \"__main__\":\n    index_unstructured_evidence()\n","Overwrite":true,"Path":"C:\\Users\\Pavan\\AppData\\Local\\Programs\\antigravity\\src\\evidence_indexer.py"}}]}
