{"step_index":334,"source":"MODEL","type":"PLANNER_RESPONSE","status":"DONE","created_at":"2026-10-24T18:42:42Z","input_tokens":2554,"cache_read_tokens":143175,"output_tokens":3567,"content":"#!/usr/bin/env python3\n\"\"\"\nZero-token local evidence indexer for Northstar Shop Deletion Audit dataset.\nParses structured logs and JSON records into SQLite cache/northstar.db.\n\"\"\"\n\nfrom __future__ import annotations\n\nimport csv\nimport json\nimport re\nimport sqlite3\nfrom pathlib import Path\nfrom typing import Any, Dict, Optional, Tuple\n\nKV_REGEX = re.compile(r'(\\w+)=(?:\"([^\"]*)\"|(\\S+))')\n\n\ndef _clean_str(val: Any) -> Optional[str]:\n    if val is None:\n        return None\n    s = str(val).strip()\n    if not s or s.lower() in (\"null\", \"none\"):\n        return None\n    return s\n\n\ndef index_unstructured_evidence(\n    evidence_dir: Path = Path(\"dataset/evidence\"),\n    conn: Optional[sqlite3.Connection] = None,\n) -> None:\n    \"\"\"\n    Parse files in logs/ and records/ and populate evidence_records in SQLite.\n    \"\"\"\n    evidence_path = Path(evidence_dir)\n    close_conn = False\n\n    if conn is None:\n        db_path = Path(\"cache/northstar.db\")\n        db_path.parent.mkdir(parents=True, exist_ok=True)\n        conn = sqlite3.connect(db_path)\n        close_conn = True\n\n    try:\n        conn.execute(\n            \"\"\"\n            CREATE TABLE IF NOT EXISTS evidence_records (\n                file_id TEXT,\n                captured_at TEXT,\n                system_id TEXT,\n                resource_id TEXT PRIMARY KEY,\n                verified_state TEXT,\n                user_id TEXT,\n                email TEXT\n            );\n            \"\"\"\n        )\n        conn.execute(\"CREATE INDEX IF NOT EXISTS idx_ev_res ON evidence_records(resource_id);\")\n        conn.execute(\"CREATE INDEX IF NOT EXISTS idx_ev_user ON evidence_records(user_id);\")\n        conn.execute(\"CREATE INDEX IF NOT EXISTS idx_ev_email ON evidence_records(email);\")\n\n        file_meta: Dict[str, Tuple[str, str]] = {}\n\n        try:\n            cur = conn.execute(\"SELECT file_id, file_path, captured_at FROM evidence_files\")\n            for row in cur.fetchall():\n                if row[1]:\n                    bname = Path(row[1]).name\n                    file_meta[bname] = (row[0] or \"\", row[2] or \"\")\n        except Exception:\n            pass\n\n        ef_csv_candidates = [\n            evidence_path.parent / \"evidence_files.csv\",\n            Path(\"dataset/evidence_files.csv\"),\n        ]\n        for ef_csv in ef_csv_candidates:\n            if ef_csv.is_file():\n                try:\n                    with ef_csv.open(\"r\", encoding=\"utf-8-sig\", newline=\"\") as f:\n                        for row in csv.DictReader(f):\n                            fp = row.get(\"file_path\")\n                            if fp:\n                                file_meta[Path(fp).name] = (\n                                    row.get(\"file_id\", \"\"),\n                                    row.get(\"captured_at\", \"\"),\n                                )\n                    break\n                except Exception:\n                    pass\n\n        merged_records: Dict[str, Tuple[str, str, str, str, str, Optional[str], Optional[str]]] = {}\n\n        def record_finding(\n            fid: str,\n            cap: str,\n            sys_id: Optional[str],\n            res_id: str,\n            state: Optional[str],\n            uid: Optional[str],\n            eml: Optional[str],\n        ) -> None:\n            if not res_id:\n                return\n            sys_id = _clean_str(sys_id) or \"\"\n            uid = _clean_str(uid)\n            eml = _clean_str(eml)\n            if eml and \"@\" not in eml:\n                if not uid and eml.startswith(\"user_\"):\n                    uid = eml\n                    eml = None\n\n            if res_id in merged_records:\n                old_fid, old_cap, old_sys, _, old_state, old_uid, old_eml = merged_records[res_id]\n                fid = fid or old_fid\n                cap = cap or old_cap\n                sys_id = sys_id or old_sys\n                uid = uid or old_uid\n                eml = eml or old_eml\n                state = state or old_state\n\n            merged_records[res_id] = (\n                fid or \"\",\n                cap or \"\",\n                sys_id,\n                res_id,\n                state or \"PRESENT\",\n                uid,\n                eml,\n            )\n\n        # 1. JSON Line Logs & Key-Value Logs\n        logs_dir = evidence_path / \"logs\"\n        if logs_dir.is_dir():\n            for log_file in sorted(logs_dir.glob(\"*.log\")):\n                fid, cap = file_meta.get(log_file.name, (\"\", \"\"))\n                try:\n                    with log_file.open(\"r\", encoding=\"utf-8\", errors=\"ignore\") as f:\n                        for line in f:\n                            line = line.strip()\n                            if not line:\n                                continue\n\n                            # JSON Line Logs\n                            j_start = line.find(\"{\")\n                            if j_start != -1 and line.endswith(\"}\"):\n                                try:\n                                    obj = json.loads(line[j_start:])\n                                    res_id = _clean_str(obj.get(\"resource_id\"))\n                                    if res_id:\n                                        sys_id = obj.get(\"service\") or obj.get(\"system_id\") or obj.get(\"logger\")\n                                        rows_val = str(obj.get(\"rows\", \"\")).strip()\n                                        status_val = str(obj.get(\"http_status\", \"\")).strip()\n                                        uid = (\n                                            obj.get(\"user_id\")\n                                            or obj.get(\"subject_ref\")\n                                            or obj.get(\"customer_reference\")\n                                            or obj.get(\"subject_reference\")\n                                        )\n                                        eml = (\n                                            obj.get(\"email\")\n                                            or obj.get(\"correlation_key\")\n                                            or obj.get(\"lookup_key\")\n                                            or obj.get(\"matched_value\")\n                                        )\n\n                                    