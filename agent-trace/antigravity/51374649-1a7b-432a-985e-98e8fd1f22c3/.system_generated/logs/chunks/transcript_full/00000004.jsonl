           if v not in ('null', 'None'):\n                        entry[k] = v\n            \n            trace_id = entry.get('trace_id') or entry.get('requestId')\n            if trace_id:\n                trace_groups.setdefault(trace_id, []).append(entry)\n\n    traces_found += len(trace_groups)\n    for tid, entries in trace_groups.items():\n        # Pass 1:\n        trace_email = None\n        trace_user_id = None\n        for e in entries:\n            for k in ('lookup_key', 'subject_ref', 'subject_reference', 'email', 'customer_email', 'requester_email'):\n                val = e.get(k)\n                if val:\n                    val = str(val).strip()\n                    if '@' in val and not trace_email:\n                        trace_email = val\n                    if val.startswith('user_') and not trace_user_id:\n                        trace_user_id = val\n        if trace_email or trace_user_id:\n            correlated_rows += 1\n\nprint('Total traces:', traces_found, 'Traces with identifiers:', correlated_rows)\n\"","WaitMsBeforeAsync":5000,"toolSummary":"Test trace correlation logic"}}]}
