{"step_index":870,"source":"MODEL","type":"GENERIC","status":"DONE","created_at":"2026-10-24T20:19:23Z","content":"Created At: 2026-10-25T01:49:23+05:30\nCompleted At: 2026-10-25T01:49:23+05:30\nShowing lines 118-195 of 2089\n118: def build_steps_json(deletion_status: str, raw_steps: List[AuditStep]) -> str:\r\n119:     \"\"\"\r\n120:     Validates, deduplicates, deterministically sorts, numbers `step_no` starting at 1,\r\n121:     and serializes `steps_json` according to `deletion_status` rules.\r\n122:     \"\"\"\r\n123:     if deletion_status == \"NOT_APPLICABLE\":\r\n124:         return \"[]\"\r\n125: \r\n126:     if deletion_status not in (\"COMPLETE\", \"INCOMPLETE\"):\r\n127:         raise ValueError(f\"Invalid deletion_status: {deletion_status}\")\r\n128: \r\n129:     normalized: Dict[Tuple[str, str, str, str], AuditStep] = {}\r\n130:     for step in raw_steps:\r\n131:         expected_state = step.validated_state()\r\n132: \r\n133:         if deletion_status == \"COMPLETE\":\r\n134:             if step.phase != \"VERIFICATION\":\r\n135:                 raise ValueError(\"COMPLETE cases may only contain VERIFICATION steps.\")\r\n136:             if not step.evidence_id:\r\n137:                 raise ValueError(\r\n138:                     f\"COMPLETE verification step on {step.system_id}/{step.resource_id} \"\r\n139:                     \"must cite a file_id, activity_id, or audit_id.\"\r\n140:                 )\r\n141:             ev_id = step.evidence_id\r\n142:         else:  # INCOMPLETE\r\n143:             if step.phase == \"FINDING\":\r\n144:                 if not step.evidence_id:\r\n145:                     raise ValueError(\r\n146:                         f\"INCOMPLETE finding step on {step.system_id}/{step.resource_id} \"\r\n147:                         \"must cite a file_id, activity_id, or audit_id.\"\r\n148:                     )\r\n149:                 ev_id = step.evidence_id\r\n150:             else:\r\n151:                 # Proposed remediation & future verification steps use empty evidence_id\r\n152:                 ev_id = \"\"\r\n153: \r\n154:         clean_step = AuditStep(\r\n155:             phase=step.phase,\r\n156:             system_id=step.system_id,\r\n157:             resource_id=step.resource_id,\r\n158:             operation=step.operation,\r\n159:             state=expected_state,\r\n160:             evidence_id=ev_id,\r\n161:         )\r\n162:         dedup_key = (\r\n163:             clean_step.phase,\r\n164:             clean_step.operation,\r\n165:             clean_step.system_id,\r\n166:             clean_step.resource_id,\r\n167:         )\r\n168:         normalized[dedup_key] = clean_step\r\n169: \r\n170:     sorted_steps = sorted(\n171:         normalized.values(),\n172:         key=lambda s: (\n173:             PHASE_ORDER[s.phase],\n174:             SYSTEM_ORDER.get(s.system_id, 99) if s.phase == \"VERIFICATION\" else 99,\n175:             s.system_id if s.phase != \"VERIFICATION\" else \"\",\n176:             s.resource_id,\n177:             s.operation,\n178:             s.evidence_id,\n179:         ),\n180:     )\n181: \r\n182:     payload = [\r\n183:         {\r\n184:             \"step_no\": idx,\r\n185:             \"phase\": s.phase,\r\n186:             \"system_id\": s.system_id,\r\n187:             \"resource_id\": s.resource_id,\r\n188:             \"operation\": s.operation,\r\n189:             \"state\": s.state,\r\n190:             \"evidence_id\": s.evidence_id,\r\n191:         }\r\n192:         for idx, s in enumerate(sorted_steps, start=1)\r\n193:     ]\r\n194:     return json.dumps(payload, separators=(\",\", \":\"))\r\n195: \r"}
