{"step_index":1084,"source":"MODEL","type":"GENERIC","status":"DONE","created_at":"2026-10-24T20:56:28Z","content":"Created At: 2026-10-25T02:26:28+05:30\nCompleted At: 2026-10-25T02:26:28+05:30\nShowing lines 1-52 of 52\n1: import csv\n2: import json\n3: import time\n4: from pathlib import Path\n5: from src.pipeline import init_database, resolve_identity, audit_case, build_steps_json\n6: \n7: t0 = time.time()\n8: conn = init_database()\n9: \n10: input_csv = Path(\"dataset/deletion_requests.csv\")\n11: output_csv = Path(\"output.csv\")\n12: \n13: if not input_csv.exists():\n14:     print(f\"Error: {input_csv} not found!\")\n15:     exit(1)\n16: \n17: with open(input_csv, encoding=\"utf-8-sig\") as f:\n18:     requests = list(csv.DictReader(f))\n19: \n20: print(f\"Starting audit for {len(requests)} production cases...\")\n21: \n22: results = []\n23: status_counts = {\"COMPLETE\": 0, \"INCOMPLETE\": 0, \"NOT_APPLICABLE\": 0}\n24: \n25: for i, req in enumerate(requests, 1):\n26:     cid = req.get(\"case_id\") or f\"case_{i:03d}\"\n27:     email = req.get(\"email\", \"\")\n28:     \n29:     identity = resolve_identity(email, conn)\n30:     status, steps = audit_case(req, identity, conn)\n31:     steps_json = build_steps_json(status, steps)\n32:     \n33:     status_counts[status] = status_counts.get(status, 0) + 1\n34:     results.append({\n35:         \"case_id\": cid,\n36:         \"deletion_status\": status,\n37:         \"steps_json\": steps_json\n38:     })\n39: \n40: conn.close()\n41: \n42: # Write output.csv with exact UTF-8 formatting and standard csv quoting\n43: with open(output_csv, \"w\", newline=\"\", encoding=\"utf-8\") as f:\n44:     writer = csv.DictWriter(f, fieldnames=[\"case_id\", \"deletion_status\", \"steps_json\"])\n45:     writer.writeheader()\n46:     writer.writerows(results)\n47: \n48: elapsed = time.time() - t0\n49: print(f\"\\nDone in {elapsed:.2f}s ({elapsed/len(requests)*1000:.1f}ms/case)\")\n50: print(f\"Total Cases: {len(results)}\")\n51: print(f\"Status Breakdown: {status_counts}\")\n52: print(f\"Saved: {output_csv.resolve()}\")\r"}
