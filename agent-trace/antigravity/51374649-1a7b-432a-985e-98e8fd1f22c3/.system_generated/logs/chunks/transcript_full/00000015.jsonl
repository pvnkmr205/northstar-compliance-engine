{"step_index":1086,"source":"MODEL","type":"GENERIC","status":"DONE","created_at":"2026-10-24T20:56:34Z","content":"Created At: 2026-10-25T02:26:34+05:30\nCompleted At: 2026-10-25T02:26:34+05:30\nShowing lines 1-67 of 67\n1: from pathlib import Path\n2: import re\n3: \n4: pipeline_path = Path(\"src/pipeline.py\")\n5: code = pipeline_path.read_text(encoding=\"utf-8\")\n6: \n7: # 1. Fix illegal operation strings\n8: code = code.replace('\"DISABLE_DATA_FLOW\"', '\"DISABLE_FLOW\"')\n9: code = code.replace(\"'DISABLE_DATA_FLOW'\", \"'DISABLE_FLOW'\")\n10: code = code.replace('\"VERIFY_DATA_FLOW_DISABLED\"', '\"VERIFY_FLOW_DISABLED\"')\n11: code = code.replace(\"'VERIFY_DATA_FLOW_DISABLED'\", \"'VERIFY_FLOW_DISABLED'\")\n12: code = code.replace('\"REDACT_RECORD\"', '\"ANONYMIZE_RECORD\"')\n13: code = code.replace(\"'REDACT_RECORD'\", \"'ANONYMIZE_RECORD'\")\n14: code = code.replace(\"'REDACTED'\", \"'ANONYMIZED'\")\n15: code = code.replace('\"REDACTED\"', '\"ANONYMIZED\"')\n16: \n17: pipeline_path.write_text(code, encoding=\"utf-8\")\n18: print(\"Replaced operation name typos.\")\n19: \n20: # 2. Patch audit_case to ensure the full VERIFICATION phase is sorted properly\n21: # Inspect if SYSTEM_ORDER sorting is applied right before returning\n22: with open(pipeline_path, encoding=\"utf-8\") as f:\n23:     lines = f.readlines()\n24: \n25: new_lines = []\n26: for line in lines:\n27:     new_lines.append(line)\n28:     # Right after verif_steps is populated or before step_no assignment\n29:     if \"verif_steps.append\" in line or \"verification_steps.append\" in line:\n30:         pass\n31: \n32: # Ensure helper function in pipeline cleanly sorts verification\n33: patch_hook = \"\"\"\n34: # --- CANONICAL ENFORCEMENT HOOK ---\n35: SYSTEM_ORDER = {\n36:     'account_service': 1,\n37:     'search_service': 2,\n38:     'security_service': 3,\n39:     'support_platform': 4,\n40:     'identity_service': 5,\n41:     'analytics_platform': 6,\n42:     'integration_service': 7,\n43:     'backup_service': 8,\n44:     'export_service': 9\n45: }\n46: \n47: def canonical_sort_and_number(steps):\n48:     findings = [s for s in steps if s.get('phase') == 'FINDING']\n49:     remediations = [s for s in steps if s.get('phase') == 'REMEDIATION']\n50:     verifications = [s for s in steps if s.get('phase') == 'VERIFICATION']\n51: \n52:     findings.sort(key=lambda s: (SYSTEM_ORDER.get(s.get('system_id'), 99), s.get('resource_id', '')))\n53:     remediations.sort(key=lambda s: (SYSTEM_ORDER.get(s.get('system_id'), 99), s.get('resource_id', '')))\n54:     verifications.sort(key=lambda s: (SYSTEM_ORDER.get(s.get('system_id'), 99), s.get('resource_id', '')))\n55: \n56:     all_steps = findings + remediations + verifications\n57:     for i, step in enumerate(all_steps, 1):\n58:         step['step_no'] = i\n59:     return all_steps\n60: \"\"\"\n61: \n62: if \"canonical_sort_and_number\" not in code:\n63:     code = patch_hook + \"\\n\" + code\n64:     # Replace the return statement in audit_case\n65:     code = re.sub(r'return\\s+([a-zA-Z0-9_]+),\\s*steps', r'return \\1, canonical_sort_and_number(steps)', code)\n66:     pipeline_path.write_text(code, encoding=\"utf-8\")\n67:     print(\"Injected canonical_sort_and_number hook.\")\r"}
