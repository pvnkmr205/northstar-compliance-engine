d=\"\",\r\n241:                 )\r\n242:             )\r\n243:     return all_steps\r\n244: \r\n245: \r\n246: # ============================================================================\r\n247: # 2. TOKEN USAGE & COST TELEMETRY TRACKER (`evaluation/usage_report.md`)\r\n248: # ============================================================================\r\n249: \r\n250: @dataclass\r\n251: class ModelPricing:\r\n252:     provider: str\r\n253:     model_name: str\r\n254:     input_cost_per_1m: float   # USD per 1M input tokens\r\n255:     output_cost_per_1m: float  # USD per 1M output tokens\r\n256: \r\n257: \r\n258: @dataclass\r\n259: class ModelStats:\r\n260:     calls: int = 0\r\n261:     input_tokens: int = 0\r\n262:     output_tokens: int = 0\r\n263: \r\n264: \r\n265: class UsageTracker:\r\n266:     \"\"\"\r\n267:     Tracks all LLM invocations during the full-dataset run and generates\r\n268:     `evaluation/usage_report.md` with per-model and overall totals.\r\n269:     \"\"\"\r\n270: \r\n271:     DEFAULT_PRICING: Dict[str, ModelPricing] = {\r\n272:         \"gemini-3.8-flash\": ModelPricing(\"Google\", \"gemini-3.8-flash\", 0.075, 0.30),\r\n273:         \"deepseek-v4.1-flash\": ModelPricing(\"DeepSeek\", \"deepseek-v4.1-flash\", 0.14, 0.28),\r\n274:         \"claude-3.5-sonnet\": ModelPricing(\"Anthropic\", \"claude-3.5-sonnet\", 3.00, 15.00),\r\n275:     }\r\n276: \r\n277:     def __init__(self, total_cases: int = 518) -> None:\r\n278:         self.total_cases = max(1, total_cases)\r\n279:         self.stats: Dict[str, ModelStats] = {}\r\n280:         self.pricing: Dict[str, ModelPricing] = dict(self.DEFAULT_PRICING)\r\n281: \r\n282:     def register_model(\r\n283:         self,\r\n284:         model_key: str,\r\n285:         provider: str,\r\n286:         input_cost_per_1m: float,\r\n287:         output_cost_per_1m: float,\r\n288:     ) -> None:\r\n289:         self.pricing[model_key] = ModelPricing(\r\n290:             provider=provider,\r\n291:             model_name=model_key,\r\n292:             input_cost_per_1m=input_cost_per_1m,\r\n293:             output_cost_per_1m=output_cost_per_1m,\r\n294:         )\r\n295: \r\n296:     def record_call(\r\n297:         self,\r\n298:         model_key: str,\r\n299:         input_tokens: int,\r\n300:         output_tokens: int,\r"}
