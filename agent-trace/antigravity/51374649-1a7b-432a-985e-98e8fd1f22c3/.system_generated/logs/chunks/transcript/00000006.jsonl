{"step_index":615,"source":"MODEL","type":"GENERIC","status":"DONE","created_at":"2026-10-24T19:57:32Z","content":"Created At: 2026-10-25T01:27:32+05:30\nCompleted At: 2026-10-25T01:27:33+05:30\nShowing lines 1-100 of 284\n1: #!/usr/bin/env python3\n2: \"\"\"Index participant-facing evidence files into the Northstar SQLite cache.\"\"\"\n3: \n4: from __future__ import annotations\n5: \n6: import csv\n7: import json\n8: import re\n9: import sqlite3\n10: from pathlib import Path\n11: from typing import Any, Dict, Iterable, Optional\n12: \n13: SUPPORTED_EXTENSIONS = {\".log\", \".json\", \".sql\", \".csv\", \".txt\"}\n14: RESOURCE_RE = re.compile(\n15:     r\"\\b(?:account|search|security|audit_record|support|identity|analytics|\"\n16:     r\"telemetry|data_flow|backup|export|tombstone|customer)[_-][A-Za-z0-9_-]+\\b\",\n17:     re.IGNORECASE,\n18: )\n19: KEY_VALUE_RE = re.compile(r'''([\\w.-]+)\\s*[:=]\\s*(?:\"([^\"]*)\"|'([^']*)'|([^,\\s}]+))''')\n20: \n21: \n22: def _text(path: Path) -> str:\n23:     try:\n24:         return path.read_text(encoding=\"utf-8-sig\", errors=\"replace\")\n25:     except OSError:\n26:         return \"\"\n27: \n28: \n29: def _system(resource: str, fields: Dict[str, Any]) -> str:\n30:     explicit = fields.get(\"system_id\") or fields.get(\"system\") or fields.get(\"service\") or fields.get(\"source_system\")\n31:     if explicit:\n32:         return str(explicit).strip()\n33:     key = resource.casefold()\n34:     for prefix, system in (\n35:         (\"account_\", \"account_service\"), (\"customer_\", \"account_service\"),\n36:         (\"search_\", \"search_service\"), (\"audit_record_\", \"security_service\"),\n37:         (\"security_\", \"security_service\"), (\"support_\", \"support_platform\"),\n38:         (\"identity_\", \"identity_service\"), (\"analytics_\", \"analytics_platform\"),\n39:         (\"telemetry_\", \"analytics_platform\"), (\"data_flow_\", \"integration_service\"),\n40:         (\"backup_\", \"backup_service\"), (\"export_\", \"export_service\"),\n41:     ):\n42:         if key.startswith(prefix):\n43:             return system\n44:     return \"\"\n45: \n46: \n47: def _system_from_table(table: str) -> str:\n48:     name = table.casefold()\n49:     for token, system in (\n50:         (\"analytics\", \"analytics_platform\"\n<truncated 172 bytes>\nsecurity_service\"),\n53:         (\"backup\", \"backup_service\"), (\"flow\", \"integration_service\"),\n54:         (\"export\", \"export_service\"), (\"account\", \"account_service\"),\n55:         (\"customer\", \"account_service\"), (\"profile\", \"account_service\"),\n56:     ):\n57:         if token in name:\n58:             return system\n59:     return \"\"\n60: \n61: \n62: def _state(fields: Dict[str, Any]) -> str:\n63:     values = \" \".join(\n64:         str(fields.get(key, \"\")) for key in\n65:         (\"verified_state\", \"state\", \"result\", \"status\", \"event\", \"operation\")\n66:     ).casefold()\n67:     if re.search(r\"\\b(absent|not_found|not found|not_found|deleted|miss|404)\\b\", values):\n68:         return \"ABSENT\"\n69:     if re.search(r\"\\b(anonymized|anonymised)\\b\", values):\n70:         return \"ANONYMIZED\"\n71:     if re.search(r\"\\bredacted\\b\", values):\n72:         return \"REDACTED\"\n73:     if re.search(r\"\\b(present|found|hit|success|200|retained)\\b\", values):\n74:         return \"PRESENT\"\n75:     direct = any(fields.get(key) not in (None, \"\", \"null\", \"None\") for key in\n76:                  (\"email\", \"phone\", \"email_hash\", \"name\", \"user_id\"))\n77:     if fields.get(\"direct_identifiers\") is False or str(fields.get(\"direct_identifiers\", \"\")).casefold() in {\"false\", \"0\", \"no\"}:\n78:         return \"ANONYMIZED\"\n79:     return \"PRESENT\" if direct else \"PRESENT\"\n80: \n81: \n82: def _records_from_json(value: Any) -> Iterable[Dict[str, Any]]:\n83:     if isinstance(value, dict):\n84:         if any(key in value for key in (\"resource_id\", \"record_id\