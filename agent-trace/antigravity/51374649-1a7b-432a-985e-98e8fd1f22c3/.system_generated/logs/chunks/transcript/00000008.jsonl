 sorted_steps = sorted(exp_steps, key=sort_key)\\n    for idx, (s1, s2) in enumerate(zip(exp_steps, sorted_steps)):\\n        if s1[\\\"resource_id\\\"] != s2[\\\"resource_id\\\"] or s1[\\\"operation\\\"] != s2[\\\"operation\\\"]:\\n            print(f\\\"[{cid}] Step {idx+1} mismatch: exp=({s1['phase']}, {s1['system_id']}, {s1['resource_id']}) vs sorted=({s2['phase']}, {s2['system_id']}, {s2['resource_id']})\\\")\\n            mismatches += 1\\n            break\\n\\nprint(f\\\"Total sort mismatches with alphabetical system_id: {mismatches}/32\\\")\\n\"","Path":"\"C:/Users/Pavan/hackerrank-orchestrate-october26/test_alpha_order.py\""}}]}
