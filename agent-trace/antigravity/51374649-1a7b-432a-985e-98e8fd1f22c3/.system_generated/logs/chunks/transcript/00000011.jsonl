ce': 9\n45: }\n46: \n47: def canonical_sort_and_number(status, steps):\n48:     if status == 'NOT_APPLICABLE' or not steps:\n49:         return []\n50:     \n51:     # Standardize dictionary access\n52:     def get_val(s, key, default=''):\n53:         if isinstance(s, dict):\n54:             return s.get(key, default)\n55:         return getattr(s, key, default)\n56: \n57:     def to_dict(s):\n58:         if isinstance(s, dict):\n59:             return dict(s)\n60:         return {\n61:             'step_no': getattr(s, 'step_no', 1),\n62:             'phase': getattr(s, 'phase', ''),\n63:             'system_id': getattr(s, 'system_id', ''),\n64:             'resource_id': getattr(s, 'resource_id', ''),\n65:             'operation': getattr(s, 'operation', ''),\n66:             'state': getattr(s, 'state', ''),\n67:             'evidence_id': getattr(s, 'evidence_id', '')\n68:         }\n69: \n70:     dict_steps = [to_dict(s) for s in steps]\n71:     findings = [s for s in dict_steps if s['phase'] == 'FINDING']\n72:     remediations = [s for s in dict_steps if s['phase'] == 'REMEDIATION']\n73:     verifications = [s for s in dict_steps if s['phase'] == 'VERIFICATION']\n74: \n75:     # Sort each phase canonically\n76:     findings.sort(key=lambda s: (SYSTEM_ORDER.get(s['system_id'], 99), s['resource_id']))\n77:     remediations.sort(key=lambda s: (SYSTEM_ORDER.get(s['system_id'], 99), s['resource_id']))\n78:     verifications.sort(key=lambda s: (SYSTEM_ORDER.get(s['system_id'], 99), s['resource_id']))\n79: \n80:     if status == 'COMPLETE':\n81:         final_steps = verifications\n82:     else:\n83:         # If INCOMPLETE but no findings, convert to COMPLETE\n84:         if not findings:\n85:             final_steps = verifications\n86:         else:\n87:             final_steps = findings + remediations + verifications\n88: \n89:     for i, s in enumerate(final_steps, 1):\n90:         s['step_no'] = i\n91: \n92:     return final_steps\n93: \"\"\"\n94: \n95: if \"def canonical_sort_and_number\" not in code:\n96:     code = code + \"\\n\" + sort_helper\n97: \n98: # Wrap return statements in audit_case with canonical_sort_and_number\n99: code = re.sub(\n100:     r'return\\s+([a-zA-Z0-9_]+),\\s*([a-zA-Z0-9_]+)(?!\\s*\\))',"}
