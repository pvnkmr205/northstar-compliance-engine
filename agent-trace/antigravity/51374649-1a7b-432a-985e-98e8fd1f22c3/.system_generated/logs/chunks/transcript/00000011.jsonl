ep_t - s[\"time\"]).total_seconds() <= 7200]\n40:     best = min(cands, key=lambda s: abs((rep_t - s[\"time\"]).total_seconds())) if cands else None\n41:     print(f\"[{cid}] rep_status={rep_status} -> Submit: {best['account'] if best else None} ({best['result'] if best else None}, act={best['activity_id'] if best else None})\")"}
