:\n51:         if len(steps) != 0:\n52:             issues.append(f\"[{cid}] NOT_APPLICABLE must have empty steps_json, got {len(steps)} steps\")\n53:         continue\n54: \n55:     if len(steps) == 0:\n56:         issues.append(f\"[{cid}] {status} case has empty steps_json\")\n57:         continue\n58: \n59:  \n<truncated 880 bytes>\n(f\"[{cid}] INCOMPLETE case has invalid phases: {seen_phase_order}\")\n78: \n79:     for step in steps:\n80:         p = step.get(\"phase\")\n81:         op = step.get(\"operation\")\n82:         sys_id = step.get(\"system_id\")\n83:         res_id = step.get(\"resource_id\", \"\")\n84:         ev_id = step.get(\"evidence_id\", \"\")\n85:         state = step.get(\"state\")\n86: \n87:         # Allowed op check\n88:         if op not in ALLOWED_OPERATIONS.get(p, []):\n89:             issues.append(f\"[{cid}] Operation '{op}' illegal in phase '{p}'\")\n90: \n91:         # Null or placeholder checks\n92:         if not res_id or \"None\" in res_id or \"null\" in res_id:\n93:             issues.append(f\"[{cid}] Invalid resource_id: '{res_id}'\")\n94: \n95:         # Rule 12 Check: Security service audit records must NEVER be deleted\n96:         if sys_id == \"security_service\" and op in [\"DELETE_RECORD\", \"REPORT_REMAINING_RECORD\"]:\n97:             issues.append(f\"[{cid}] Rule 12 Violation: audit record targeted for deletion: {res_id}\")\n98: \n99:         # Remediation evidence_id check: must be empty string\n100:         if p == \"REMEDIATION\" and ev_id != \"\":\n101:             issues.append(f\"[{cid}] REMEDIATION step has non-empty evidence_id: '{ev_id}'\")\n102: \n103:     # 4. Topological sort order in VERIFICATION phase\n104:     verif_steps = [s for s in steps if s.get(\"phase\") == \"VERIFICATION\"]\n105:     verif_ranks = [SYSTEM_ORDER.get(s.get(\"system_id\"), 99) for s in verif_steps]\n106:     if verif_ranks != sorted(verif_ranks):\n107:         systems = [s.get(\"system_id\") for s in verif_steps]\n108:         issues.append(f\"[{cid}] Verification system ordering violation: {systems}\")\n109: \n110: print(f\"=== AUDIT RESULTS ===\")\n111: print(f\"Total Cases Checked: {len(rows)}\")\n112: print(f\"Total Invariant Issues Found: {len(issues)}\")\n113: if issues:\n114:     print(\"\\nFirst 10 Issues:\")\n115:     for iss in issues[:10]:\n116:         print(f\" - {iss}\")\n117: else:\n118:     print(\"\\nALL INVARIANTS SATISFIED: Zero schema errors, zero sequence flaws, zero illegal operations.\")\r","truncated_fields":["content"]}
