eps_accuracy) / 2\r\n1382: \r\n1383: \r\n1384: def run_pipeline(dataset_dir: Path = Path(\"dataset\"), output_csv: Path = Path(\"output.csv\")) -> None:\r\n1385:     conn = init_database(dataset_dir)\r\n1386:     try:\r\n1387:         validate_samples(conn, dataset_dir)\r\n1388:         with (dataset_dir / \"deletion_requests.csv\").open(\"r\", encoding=\"utf-8-sig\", newline=\"\") as source:\r\n1389:             cases = sorted(csv.DictReader(source), key=lambda row: row[\"case_id\"])\r\n1390:         tracker = UsageTracker(total_cases=len(cases))\r\n1391:         output_csv.parent.mkdir(parents=True, exist_ok=True)\r\n1392:         with output_csv.open(\"w\", encoding=\"utf-8\", newline=\"\") as target:\r\n1393:             writer = csv.DictWriter(target, fieldnames=[\"case_id\", \"deletion_status\", \"steps_json\"], lineterminator=\"\\n\")\r\n1394:             writer.writeheader()\r\n1395:             for case in cases:\r\n1396:                 identity = resolve_identity(case[\"email\"], conn)\r\n1397:                 status, steps = audit_case(case, identity, conn)\r\n1398:                 writer.writerow({\"case_id\": case[\"case_id\"], \"deletion_status\": status, \"steps_json\": build_steps_json(status, steps)})\r\n1399:         with output_csv.open(\"r\", encoding=\"utf-8-sig\", newline=\"\") as source:\r\n1400:             written = list(csv.DictReader(source))\r"}
