4:         findings = [step for step in steps if step.phase == \"FINDING\"]\r\n1245:         remediations = [step for step in steps if step.phase == \"REMEDIATION\"]\r\n1246:         finding_resources = {(step.system_id, step.resource_id) for step in findings}\r\n1247:         verifications = [\r\n1248:             step for step in steps\r\n1249:             if step.phase == \"VERIFICATION\"\r\n1250:             and (step.system_id, step.resource_id) in finding_resources\r\n1251:         ]\r\n1252: \r\n1253:         user_id = next(iter(sorted(identity.user_ids)), \"\")\r\n1254:         suffix = user_id.removeprefix(\"user_\")\r\n1255:         primary_account = next(\r\n1256:             (resource for resource in sorted(identity.linked_resources)\r\n1257:              if resource.casefold().startswith(\"account_\")),\r\n1258:             f\"account_{suffix.zfill(3)}\" if suffix.isdigit() else f\"account_{suffix}\",\r\n1259:         )\r\n1260:         if not any(resource == primary_account for _system, resource in finding_resources):\r\n1261:             verifications.append(AuditStep(\r\n1262:                 \"VERIFICATION\", \"account_service\", primary_account,\r\n1263:                 \"VERIFY_RECORD_ABSENT\", \"ABSENT\", \"\",\r\n1264:             ))\r\n1265: \r\n1266:         audit_resources = {\r\n1267:             str(record.get(\"resource_id\") or \"\")\r\n1268:             for record in evidence_rows\r\n1269:             if _time_key(record.get(\"captured_at\")) <= cutoff\r\n1270:             and str(record.get(\"system_id\") or \"\") == \"security_service\"\r\n1271:             and str(record.get(\"resource_id\") or \"\").startswith(\"audit_record_\")\r\n1272:             and str(record.get(\"state\") or \"\").upper() == \"PRESENT\"\r\n1273:         }\r\n1274:         for resource in sorted(audit_resources):\r\n1275:             verifications.append(AuditStep(\r\n1276:                 \"VERIFICATION\", \"security_service\", resource,\r\n1277:                 \"VERIFY_RECORD_PRESENT\", \"PRESENT\", \"\",\r\n1278:             ))\r\n1279:         return \"INCOMPLETE\", _canonicalize_audit_steps(\r\n1280:             findings + remediations + verifications\r\n1281:         )\r\n1282: \r\n1283:     if status == \"COMPLETE\":\r\n1284:         user_id = next(iter(sorted(identity.user_ids)), \"\")\r\n1285:         suffix = user_id.removeprefix(\"user_\")\r\n"}
