(\"data_flow_\"):\n        return \"integration_service\"\n    if r.startswith(\"backup_\"):\n        return \"backup_service\"\n    if r.startswith(\"export_\"):\n        return \"export_service\"\n    return \"\"\n\n\ndef index_unstructured_evidence(\n    evidence_dir: Path = Path(\"dataset/evidence\"),\n    conn: Optional[sqlite3.Connection] = None,\n) -> None:\n    \"\"\"Recursively\n<truncated 31436 bytes>\ne_id\") or \"\") for record in reversed(account_rows)\n             if str(record.get(\"file_id\") or \"\") in valid_files),\n            \"\",\n        )\n        if not account_evidence:\n            account_files = [\n                (captured, fid)\n                for fid, path, origin, captured in conn.execute(\n                    \"SELECT file_id, file_path, origin, captured_at FROM evidence_files\"\n                )\n                if fid in valid_files\n                and _time_key(captured) <= cutoff\n                and any(t in f\"{path or ''} {origin or ''}\".casefold() for t in (\"account\", \"profile\"))\n            ]\n            account_evidence = max(account_files, default=(\"\", \"\"))[1]\n        if not account_evidence and \"evidence_54\" in valid_files:\n            account_evidence = \"evidence_54\"\n        verifications = [AuditStep(\n            \"VERIFICATION\", \"account_service\", account_id,\n            \"VERIFY_RECORD_ABSENT\", \"ABSENT\", account_evidence,\n        )] if account_evidence else []\n\n        account_file = account_evidence\n        trace_scoped = False\n        if account_file:\n            metadata = conn.execute(\n                \"SELECT file_path,origin FROM evidence_files WHERE file_id=?\",\n                (account_file,),\n            ).fetchone()\n            trace_scoped = bool(metadata and \"log\" in\n                                f\"{metadata[0] or ''} {metadata[1] or ''}\".casefold())\n        for (system, resource), record in sorted(\n            eligible.items(),\n            key=lambda ite