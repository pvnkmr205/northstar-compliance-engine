nce_records(email);\")\n\n        file_meta: Dict[str, Tuple[str, str]] = {}\n\n        try:\n            cur = conn.execute(\"SELECT file_id, file_path, captured_at FROM evidence_files\")\n            for row in cur.fetchall():\n                if row[1]:\n                    bname = Path(row[1]).name\n                    file_meta[bname] = (ro\n<truncated 11071 bytes>\n               and not _clean_str(item.get(\"phone\"))\n                                and not _clean_str(item.get(\"email_hash\"))\n                            ):\n                                state = \"ANONYMIZED\"\n                            else:\n                                state = \"PRESENT\"\n\n                            record_finding(fid, cap, sys_id, res_id, state, uid, eml)\n                    except Exception:\n                        pass\n                elif rec_file.suffix == \".txt\":\n                    try:\n                        for line in rec_file.read_text(encoding=\"utf-8\", errors=\"ignore\").splitlines():\n                            if \"|\" in line:\n                                parts = [x.strip() for x in line.split(\"|\")]\n                                if len(parts) >= 5:\n                                    line_sys = parts[1]\n                                    line_res = parts[2]\n                                    line_result = parts[4].upper()\n                                    line_subj = parts[5] if len(parts) > 5 else None\n                                    state = \"ABSENT\" if line_result == \"NOT_FOUND\" else \"PRESENT\"\n                                    uid = line_subj if line_subj and line_subj.startswith(\"user_\") else None\n                                    eml = line_subj if line_subj and \"@\" in line_subj else None\n                                    record_finding(fid, cap, line_sys, line_res, state, uid, eml)\n                    except Exception:\n                        pass\n\n        if merged_records:\n          