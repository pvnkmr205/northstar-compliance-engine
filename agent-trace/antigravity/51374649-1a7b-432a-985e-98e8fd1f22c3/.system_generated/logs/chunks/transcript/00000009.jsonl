id\\\"], r[\\\"email\\\"]))\\n\\n# Sort requests by reported_at\\nreq_times.sort(key=lambda r: r[1])\\n\\n# For each request, how close is the nearest submit?\\ndiffs = []\\nfor req_t, rep_t, cid, em in req_times[:40]:\\n    # candidates where s[0] <= rep_t\\n    cands = [s for s in submits if req_t <= s[0] <= rep_t]\\n    closest = min(submits, key=lambda s: abs((rep_t - s[0]).total_seconds()))\\n    diff_sec = abs((rep_t - closest[0]).total_seconds())\\n    diffs.append((diff_sec, cid, closest[1], len(cands)))\\n\\nprint(\\\"Sample request-to-submit diffs (in seconds):\\\")\\nfor d, cid, acc, nc in diffs[:15]:\\n    print(f\\\"  {cid}: diff={d/60:.1f} min | closest={acc} | candidates in window={nc}\\\")\\n\"","Path":"\"C:/Users/Pavan/hackerrank-orchestrate-october26/test_submit_mapping.py\""}}]}
